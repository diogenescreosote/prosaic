#!/bin/bash
#
# agent-run — the one seam between prosaic and whatever headless agent
# CLI is installed.
#
# Every place prosaic needs "an agent, run once, noninteractively" —
# the sync triage pass, the AI test judge, a flow step — goes through
# this script, so supporting a new agent CLI is one case branch here
# and nothing anywhere else. ADR-0005 promised the seam would be one
# CLI call, documented for substitution; ADR-0020 makes the seam this
# file.
#
# Usage:
#   agent-run --check                      # print provider name; exit 0 if usable
#   agent-run [--dir DIR]... [--yolo] [--role NAME] [--model M] [--max-turns N] < prompt.txt
#
# --role NAME reads `agent.roles.NAME` from ./matter.yaml (the matter is
# the working directory) for a model and a turn cap, so a deployment
# routes triage, refine and judge work to the models it chooses without
# editing prosaic (ADR-0044). Explicit --model/--max-turns win over the
# role. With neither, the harness's own default model runs uncapped.
#
# The prompt arrives on stdin (prompts are long; argv mangles them).
# The agent's output goes to stdout. --dir grants read access to a
# directory outside the working directory, for harnesses that sandbox
# reads. --yolo skips permission prompts entirely — callers use it
# only where ADR-0005's mitigations apply (a versioned prompt, a
# narrow worklist, git review of every change).
#
# Provider selection, first match wins:
#   PROSAIC_AGENT_CMD   a custom command line, run via sh -c with the
#                       prompt on stdin; AGENT_RUN_DIRS (colon-
#                       separated) and AGENT_RUN_YOLO (0/1) are
#                       exported for it to consult
#   PROSAIC_AGENT_CLI   force one of: claude | codex | gemini
#   (unset)             first of claude, codex, gemini found on PATH
#
# Each provider's incantation lives in exactly one function below, so
# when a CLI changes its flags the fix is one line in one place.

set -u

MODE=run
YOLO=0
ROLE=""
MODEL="${AGENT_RUN_MODEL:-}"
MAX_TURNS="${AGENT_RUN_MAX_TURNS:-}"
DIRS=()

while [ $# -gt 0 ]; do
  case "$1" in
    --check) MODE=check ;;
    --yolo)  YOLO=1 ;;
    --role)  shift; ROLE="${1:?--role needs an argument}" ;;
    --model) shift; MODEL="${1:?--model needs an argument}" ;;
    --max-turns) shift; MAX_TURNS="${1:?--max-turns needs an argument}" ;;
    --dir)   shift; DIRS+=("${1:?--dir needs an argument}") ;;
    -h|--help)
      sed -n '2,35p' "$0" | sed 's/^# \{0,1\}//'
      exit 0 ;;
    *) echo "agent-run: unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

# Role -> model / turn cap, from ./matter.yaml `agent.roles.<role>`.
# Python with PyYAML is what the sync already requires; without it the
# role silently resolves to nothing, which is the pre-ADR-0044 behavior.
resolve_role() {
  [ -n "$ROLE" ] || return 0
  [ -f matter.yaml ] || return 0
  local py out m t
  for py in python3 /opt/homebrew/bin/python3 /usr/bin/python3; do
    command -v "$py" >/dev/null 2>&1 || continue
    "$py" -c "import yaml" >/dev/null 2>&1 || continue
    out="$("$py" - "$ROLE" <<'PY'
import sys, yaml
role = sys.argv[1]
cfg = yaml.safe_load(open("matter.yaml")) or {}
r = ((cfg.get("agent") or {}).get("roles") or {}).get(role) or {}
print(r.get("model") or "")
print(r.get("max_turns") or "")
print(r.get("cmd") or "")
print(r.get("credential") or "")
print(r.get("credential_env") or "OPENAI_API_KEY")
PY
)" || return 0
    m="$(printf '%s\n' "$out" | sed -n 1p)"; t="$(printf '%s\n' "$out" | sed -n 2p)"
    local c cred cenv
    c="$(printf '%s\n' "$out" | sed -n 3p)"; cred="$(printf '%s\n' "$out" | sed -n 4p)"; cenv="$(printf '%s\n' "$out" | sed -n 5p)"
    [ -z "$MODEL" ] && [ -n "$m" ] && MODEL="$m"
    [ -z "$MAX_TURNS" ] && [ -n "$t" ] && MAX_TURNS="$t"
    # A role may name its own command (another vendor's CLI or a script);
    # it becomes the custom provider for this run. The model name is
    # exported for it, and a Keychain item named by `credential:` is
    # resolved into the environment variable the command expects (ADR-0031:
    # credentials by reference; the key never sits in the matter).
    if [ -n "$c" ] && [ -z "${PROSAIC_AGENT_CMD:-}" ]; then
      export PROSAIC_AGENT_CMD="$c"
      [ -n "$MODEL" ] && export AGENT_RUN_MODEL="$MODEL"
      if [ -n "$cred" ] && [ -z "${!cenv:-}" ] && command -v security >/dev/null 2>&1; then
        local secret
        secret="$(security find-generic-password -s "$cred" -w 2>/dev/null || true)"
        [ -n "$secret" ] && export "$cenv=$secret"
      fi
    fi
    return 0
  done
}

provider() {
  if [ -n "${PROSAIC_AGENT_CMD:-}" ]; then
    echo custom; return 0
  fi
  case "${PROSAIC_AGENT_CLI:-}" in
    "")
      local c
      for c in claude codex gemini; do
        if command -v "$c" >/dev/null 2>&1; then echo "$c"; return 0; fi
      done
      return 1 ;;
    claude|codex|gemini)
      if command -v "$PROSAIC_AGENT_CLI" >/dev/null 2>&1; then
        echo "$PROSAIC_AGENT_CLI"; return 0
      fi
      echo "agent-run: PROSAIC_AGENT_CLI=$PROSAIC_AGENT_CLI but it is not on PATH" >&2
      return 1 ;;
    *)
      echo "agent-run: unsupported PROSAIC_AGENT_CLI='$PROSAIC_AGENT_CLI'" \
           "(claude|codex|gemini, or set PROSAIC_AGENT_CMD)" >&2
      return 1 ;;
  esac
}

run_claude() {
  local prompt="$1" args=()
  local d
  for d in "${DIRS[@]+"${DIRS[@]}"}"; do args+=(--add-dir "$d"); done
  [ "$YOLO" = 1 ] && args+=(--dangerously-skip-permissions)
  [ -n "$MODEL" ] && args+=(--model "$MODEL")
  [ -n "$MAX_TURNS" ] && args+=(--max-turns "$MAX_TURNS")
  claude -p "$prompt" "${args[@]+"${args[@]}"}"
}

run_codex() {
  local prompt="$1" args=(--skip-git-repo-check)
  # codex's read-only sandbox can already read outside the working
  # directory, so --dir needs no translation here.
  if [ "$YOLO" = 1 ]; then
    args+=(--dangerously-bypass-approvals-and-sandbox)
  else
    args+=(--sandbox read-only)
  fi
  codex exec "${args[@]}" "$prompt"
}

run_gemini() {
  local prompt="$1" args=()
  if [ ${#DIRS[@]} -gt 0 ]; then
    args+=(--include-directories "$(IFS=,; echo "${DIRS[*]}")")
  fi
  [ "$YOLO" = 1 ] && args+=(--yolo)
  gemini "${args[@]+"${args[@]}"}" -p "$prompt"
}

run_custom() {
  local prompt="$1"
  AGENT_RUN_DIRS="$(IFS=:; echo "${DIRS[*]+"${DIRS[*]}"}")" \
  AGENT_RUN_YOLO="$YOLO" \
    sh -c "$PROSAIC_AGENT_CMD" <<< "$prompt"
}

# The role may name its own command, which must be known before the
# provider is chosen.
resolve_role
PROVIDER="$(provider)" || {
  [ "$MODE" = check ] && exit 1
  echo "agent-run: no agent CLI found (claude, codex, or gemini on PATH," \
       "or set PROSAIC_AGENT_CLI / PROSAIC_AGENT_CMD)" >&2
  exit 1
}

if [ "$MODE" = check ]; then
  echo "$PROVIDER"
  exit 0
fi

PROMPT="$(cat)"
if [ -z "$PROMPT" ]; then
  echo "agent-run: empty prompt on stdin" >&2
  exit 2
fi

case "$PROVIDER" in
  claude) run_claude "$PROMPT" ;;
  codex)  run_codex  "$PROMPT" ;;
  gemini) run_gemini "$PROMPT" ;;
  custom) run_custom "$PROMPT" ;;
esac
