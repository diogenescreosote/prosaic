#: Directories whose contents are regenerable or disposable by age: rendered
#: output, flow run directories, and search checklists. Never assets/,
#: pleadings/, discovery/, processed_files/ or derived/text/.
AGE_CLEAN_DIRS = ("out", ".flow", "derived/find", "derived/refine", "derived/standup", "derived/review")


def _clean_older_than(matter: Path, days: int, apply: bool) -> int:
    """Report (or with --apply remove) regenerable files older than N days
    in the disposable trees. Tracked files are called out separately."""
    import time
    cutoff = time.time() - days * 86400
    tracked = set(_git_lines(matter, "ls-files", *AGE_CLEAN_DIRS))
    old: list[tuple[str, bool]] = []
    for d in AGE_CLEAN_DIRS:
        root = matter / d
        if not root.is_dir():
            continue
        for p in root.rglob("*"):
            if p.is_file() and not p.name.startswith(".build_manifest") and p.stat().st_mtime < cutoff:
                rel = str(p.relative_to(matter))
                old.append((rel, rel in tracked))
    if not old:
        print(f"nothing older than {days} days under {', '.join(AGE_CLEAN_DIRS)}")
        return 0
    for rel, t in sorted(old):
        print(f"  {'tracked  ' if t else 'untracked'}  {rel}")
    print(f"\n{len(old)} file(s) older than {days} days; {sum(1 for _, t in old if t)} tracked.")
    if not apply:
        print("Nothing deleted. Re-run with --apply to remove them. A hand-assembled packet or a "
              "timestamp token in out/ is not regenerable: check the list before you do.")
        return 0
    for rel, _ in old:
        (matter / rel).unlink()
    print(f"Removed {len(old)} file(s). Commit the deletions to record them.")
    return 0


def cmd_clean(args: argparse.Namespace) -> int:
    """Report — and optionally remove — files in out/ the config cannot produce.

    Stale build output is not merely untidy in a matter. An old PDF in
    `out/` is indistinguishable from a current one, and it is the thing
    someone attaches to an email. The two hand-assembled `.packet.pdf`
    files that prompted this were months out of date, carried captions
    the current build no longer produces, and nothing regenerated them.

    Reporting is the default and deleting is opt-in, because the
    expected-output set is computed from config and a bug there would
    delete real work. Tracked files are called out separately: git can
    give those back, and nothing else can.
    """
    matter = Path(args.matter_dir).expanduser().resolve()
    if getattr(args, "older_than", None):
        return _clean_older_than(matter, args.older_than, args.apply)
    out_root = matter / "out"
    if not out_root.is_dir():
        print(f"No out/ directory in {matter}.")
        return 0

    listing = subprocess.run(
        [sys.executable, str(ROOT / "pleading" / "build_envelope.py"), "--list-outputs"],
        cwd=matter, capture_output=True, text=True,
    )
    if listing.returncode != 0:
        print(f"could not read the envelope config:\n{listing.stderr}", file=sys.stderr)
        return 1
    expected = set()
    protected_dirs = set()
    for line in listing.stdout.splitlines():
        line = line.strip()
        if not line:
            continue
        if line.endswith("/*"):
            protected_dirs.add(line[:-2])
        else:
            expected.add(line)

    tracked = set()
    rev = subprocess.run(["git", "ls-files", "out"], cwd=matter,
                         capture_output=True, text=True)
    if rev.returncode == 0:
        tracked = set(rev.stdout.split("\n"))

    stale = []
    for path in sorted(out_root.rglob("*")):
        if not path.is_file():
            continue
        rel = str(path.relative_to(matter))
        if rel in expected:
            continue
        if any(rel.startswith(d + "/") for d in protected_dirs):
            continue
        stale.append((rel, rel in tracked))

    if not stale:
        print("out/ is clean — every file is one the current config produces.")
        return 0

    for rel, is_tracked in stale:
        print(f"  {'tracked  ' if is_tracked else 'untracked'}  {rel}")
    n_tracked = sum(1 for _, t in stale if t)
    print(f"\n{len(stale)} stale file(s); {n_tracked} tracked, "
          f"{len(stale) - n_tracked} untracked.")

    if not args.apply:
        print("\nNothing deleted. Re-run with --apply to remove them.")
        if n_tracked:
            print("Tracked files are recoverable from git history; "
                  "untracked ones are not.")
        return 0

    for rel, _ in stale:
        (matter / rel).unlink()
    print(f"\nRemoved {len(stale)} file(s). Commit the deletions to record them.")
    return 0


