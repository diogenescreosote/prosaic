#!/usr/bin/env python3
"""sc — the prosaic operations command line.

Thin dispatcher over the repo's components; run `sc <command> -h` for
details. Commands:

  init <dir>              scaffold a new matter directory
  sync <dir>              run configured connectors + AI triage now
  build <envelope>        build a filing envelope (from a matter dir)
  list                    list envelopes (from a matter dir)
  clean [dir]             report stale files in out/ (--apply removes them)
  ocr <pdf> <outdir>      OCR-supplement one PDF
  connectors              list available connectors
  backup <action> [dir]   init/push/status a matter's backup upstream
  commit-check [file]     validate a matter commit message
  hooks <dir>             install the matter git hooks
  deps                    report which system dependencies are present
  schedule <dir>          install the 12-hourly background sync (macOS)
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent

MATTER_DIRS = [
    "inbox",
    "processed_files",
    "assets",
    "assets/gmail",
    "pleadings",
    "discovery",
    "src",
    "memos",
    "lawyer_drafts",
    "unfiled",
]


APP = "prosaic"

#: Where prosaic keeps things, by kind. This is the *only*
#: implementation of that policy in the repo: the shell helpers and the
#: Node connectors call `sc paths <kind>` rather than reimplementing
#: it, so the copies cannot drift because there are no copies. Callers
#: that spawn children export the answer (PROSAIC_*_DIR), so the
#: usual path costs no subprocess at all.
PATH_KINDS = ("log-dir", "data-dir", "cache-dir")


def _platform() -> str:
    return os.environ.get("PROSAIC_PLATFORM") or sys.platform


def _xdg(env_name: str, fallback: str) -> Path:
    """$XDG_<X>_HOME if set and absolute, else ~/<fallback>.

    The absolute check is the spec's: XDG says a relative value is
    invalid and must be ignored rather than resolved against the cwd,
    which would scatter files wherever a process happened to start.
    """
    from_env = os.environ.get(env_name)
    if from_env and os.path.isabs(from_env):
        return Path(from_env) / APP
    return Path.home() / fallback / APP


def app_path(kind: str) -> Path:
    """Resolve one application directory."""
    override = {
        "log-dir": "PROSAIC_LOG_DIR",
        "data-dir": "PROSAIC_DATA_DIR",
        "cache-dir": "PROSAIC_CACHE_DIR",
    }.get(kind)
    if override is None:
        raise ValueError(f"unknown path kind {kind!r} (expected one of {', '.join(PATH_KINDS)})")
    from_env = os.environ.get(override)
    if from_env:
        return Path(from_env)

    darwin = _platform().startswith(("darwin", "Darwin"))
    if kind == "log-dir":
        # Logs: human-readable, disposable, safe to delete.
        if darwin:
            return Path.home() / "Library/Logs" / APP
        return _xdg("XDG_STATE_HOME", ".local/state") / "logs"
    if kind == "data-dir":
        # Durable data — browser profiles, downloaded models. Pinned to
        # the XDG location on macOS too, because that is where it
        # already is: relocating it would invalidate live portal
        # sessions. An idiomatic move needs a migration.
        return _xdg("XDG_DATA_HOME", ".local/share")
    if darwin:
        return Path.home() / "Library/Caches" / APP
    return _xdg("XDG_CACHE_HOME", ".cache")


def cmd_paths(args: argparse.Namespace) -> int:
    print(app_path(args.kind))
    return 0


def cmd_init(args: argparse.Namespace) -> int:
    dest = Path(args.matter_dir).expanduser().resolve()
    dest.mkdir(parents=True, exist_ok=True)
    template = ROOT / "templates" / "matter"
    for d in MATTER_DIRS:
        (dest / d).mkdir(parents=True, exist_ok=True)
    for f in template.rglob("*"):
        if f.is_dir():
            continue
        rel = f.relative_to(template)
        if rel.name == "processed_files_MANIFEST.md":
            target = dest / "processed_files" / "MANIFEST.md"
        else:
            target = dest / rel
        if target.exists() and not args.force:
            print(f"  keep existing {target.relative_to(dest)}")
            continue
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy(f, target)
        print(f"  wrote {target.relative_to(dest)}")
    makefile = dest / "Makefile"
    if not makefile.exists():
        makefile.symlink_to(ROOT / "pleading" / "Makefile")
        print("  linked Makefile")
    if args.git and not (dest / ".git").exists():
        subprocess.run(["git", "init", "-q"], cwd=dest, check=True)
        print("  git init")
    if (dest / ".git").exists():
        # On by default rather than a per-clone ritual: the commit
        # convention is only worth anything if it is there from the
        # first commit.
        cmd_hooks(argparse.Namespace(matter_dir=str(dest)))
    print(f"Matter scaffolded at {dest}. Next: edit matter.yaml, then `sc sync {dest}`.")
    return 0


def cmd_sync(args: argparse.Namespace) -> int:
    cmd = ["/bin/bash", str(ROOT / "sync" / "matter_sync.sh"), str(Path(args.matter_dir).resolve())]
    if args.scheduled:
        cmd.append("--scheduled")
    return subprocess.run(cmd).returncode


def _build(argv: list[str]) -> int:
    return subprocess.run(
        [sys.executable, str(ROOT / "pleading" / "build_envelope.py"), *argv]
    ).returncode


def cmd_build(args: argparse.Namespace) -> int:
    extra = []
    if args.force:
        extra.append("--force")
    if args.variant:
        extra += ["--variant", args.variant]
    if args.sign:
        extra += ["--sign", args.sign]
    return _build([args.envelope, *extra])


def cmd_list(_args: argparse.Namespace) -> int:
    return _build(["--list"])


