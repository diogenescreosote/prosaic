    sp = sub.add_parser("backup", help="back a matter up to its configured upstream")
    sp.add_argument("action", choices=("init", "push", "status"))
    sp.add_argument("matter_dir", nargs="?", default=".")
    sp.set_defaults(func=cmd_backup)

    sp = sub.add_parser("commit-check", help="validate a matter commit message")
    sp.add_argument("message_file", nargs="?",
                    help="file holding the message (default: stdin)")
    sp.add_argument("--list-types", action="store_true",
                    help="print the commit types and what they mean")
    sp.set_defaults(func=cmd_commit_check)

    sp = sub.add_parser("hooks", help="install the matter git hooks")
    sp.add_argument("matter_dir")
    sp.set_defaults(func=cmd_hooks)

    sp = sub.add_parser("deps", help="report or list the system dependencies")
    sp.add_argument(
        "--format",
        choices=("check", "apt", "brew"),
        default="check",
        help="check what's installed (default), or emit a package list",
    )
    sp.set_defaults(func=cmd_deps)

    sp = sub.add_parser("schedule", help="install the 12-hourly background sync (macOS)")
    sp.add_argument("matter_dir")
    sp.add_argument("times", nargs="*", help="two HH:MM firing times (default 08:00 20:00)")
    sp.set_defaults(func=cmd_schedule)

    args = p.parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
