#: The system binaries the pipeline shells out to, declared in one
#: place so they stop being prose in docs/ that you discover by way of
#: a failed build. The Dockerfile installs from this list and the
#: suite checks it against the code's actual subprocess calls.
DEPS_FILE = ROOT / "system-dependencies.yaml"


def load_dependencies() -> list[dict]:
    try:
        import yaml
    except ModuleNotFoundError:
        raise SystemExit(
            "sc deps needs PyYAML.  pip install -r pleading/requirements.txt"
        )
    return yaml.safe_load(DEPS_FILE.read_text())["dependencies"]


def _this_platform() -> str:
    return "darwin" if _platform().startswith(("darwin", "Darwin")) else "linux"


def _applies_here(dep: dict) -> bool:
    return _this_platform() in (dep.get("platforms") or ["darwin", "linux"])


def _version_of(binary: str) -> tuple[int, ...] | None:
    """Best-effort `--version` probe. Unparseable is not a failure.

    Nothing here should reject a working install because its version
    string had an unusual shape — the check exists to catch a distro
    Node too old for Puppeteer, not to be a version policy.
    """
    import re

    try:
        out = subprocess.run(
            [binary, "--version"], capture_output=True, text=True, timeout=10
        )
    except (OSError, subprocess.SubprocessError):
        return None
    m = re.search(r"(\d+)\.(\d+)(?:\.(\d+))?", (out.stdout or "") + (out.stderr or ""))
    if not m:
        return None
    return tuple(int(g) for g in m.groups() if g is not None)


def cmd_deps(args: argparse.Namespace) -> int:
    deps = load_dependencies()

    if args.format == "apt":
        # What the Linux image installs. Entries excluded from the
        # container (transcription, the Keychain, the triage CLI) are
        # excluded here by construction rather than by a second list.
        pkgs = {d["apt"] for d in deps if d.get("apt") and d.get("in_container")}
        print(" ".join(sorted(pkgs)))
        return 0

    if args.format == "brew":
        pkgs = {
            d["brew"]
            for d in deps
            if d.get("brew") and "darwin" in (d.get("platforms") or [])
        }
        print(" ".join(sorted(pkgs)))
        return 0

    here = _this_platform()
    missing_required: list[str] = []
    for dep in deps:
        if not _applies_here(dep):
            continue
        binary, required = dep["binary"], dep.get("required", False)
        found = shutil.which(binary)
        note = ""
        if found:
            mark = "ok "
            want = dep.get("minimum_version")
            if want:
                have = _version_of(binary)
                wanted = tuple(int(p) for p in str(want).split("."))
                if have and have[: len(wanted)] < wanted:
                    mark = "OLD"
                    note = f"have {'.'.join(map(str, have))}, need {want}+"
                    if required:
                        missing_required.append(binary)
        else:
            mark = "MISSING" if required else "--"
            hint = dep.get("brew") if here == "darwin" else dep.get("apt")
            manager = "brew install" if here == "darwin" else "apt install"
            note = f"{manager} {hint}" if hint else dep.get("npm", "") or "not packaged"
            if required:
                missing_required.append(binary)
        print(f"  {mark:<8} {binary:<14} {note or dep['why']}")

    if missing_required:
        print(
            "\nMissing required: " + ", ".join(missing_required),
            file=sys.stderr,
        )
        return 1
    return 0


#: Commit types for a matter, taken from what a docket records rather
#: than from what a build system records. The distinction that earns
#: the vocabulary is `draft` vs `docket`: a final-looking PDF in out/
#: is identical whether or not it was ever filed, and only the history
#: can say which. See docs/commits.md and ADR-0014.
COMMIT_TYPES = {
    "intake": "material arrived; nothing evaluated yet",
    "triage": "material became evidence: OCR, sidecars, INDEX row",
    "draft": "work product written or revised; not filed",
    "build": "outputs regenerated from sources; no decisions inside",
    "docket": "a real-world event: filed, served, lodged, received",
    "discovery": "requests, responses, subpoenas, productions",
    "record": "durable case knowledge (KNOWLEDGE, TODO, QUESTIONS)",
    "config": "matter machinery (matter.yaml, envelopes.yaml, build config)",
    "chore": "housekeeping with no case meaning",
}

#: Types that assert something happened outside this folder, and the
#: footer that has to say what. An agent may never supply these from
#: inference — only from the document itself or the user's statement.
#: Filed/Served/Lodged/Received are litigation's verbs; Executed and
#: Recorded are estate practice's (an instrument is signed, a deed
#: hits the county recorder) — matter types share one docket grammar.
DOCKET_FOOTERS = ("Filed", "Served", "Lodged", "Received", "Executed", "Recorded")

#: Types where provenance is the question a reader will actually have.
SOURCE_REQUIRED = ("intake", "triage", "docket")

COMMIT_SUBJECT_MAX = 72


def _check_commit_message(text: str) -> tuple[list[str], list[str]]:
    """Return (errors, warnings) for one commit message."""
    import re

    errors: list[str] = []
    warnings: list[str] = []

    lines = [ln.rstrip() for ln in text.splitlines()]
    # Ignore the comment block git appends in an editor session.
    lines = [ln for ln in lines if not ln.startswith("#")]
    while lines and not lines[0].strip():
        lines.pop(0)
    if not lines:
        return (["empty commit message"], warnings)

    subject = lines[0]
    m = re.match(r"^(?P<type>[a-z]+)(?:\((?P<scope>[^)]+)\))?(?P<bang>!)?: (?P<rest>.+)$",
                 subject)
    if not m:
        errors.append(
            f"subject must read `type(scope): summary` — got {subject!r}.\n"
            f"  types: {', '.join(sorted(COMMIT_TYPES))}"
        )
        return (errors, warnings)

    ctype = m.group("type")
    if ctype not in COMMIT_TYPES:
        errors.append(
            f"unknown type {ctype!r}. Types and what they mean:\n  "
            + "\n  ".join(f"{k:<10} {v}" for k, v in sorted(COMMIT_TYPES.items()))
        )

    if len(subject) > COMMIT_SUBJECT_MAX:
        warnings.append(
            f"subject is {len(subject)} chars; keep it under {COMMIT_SUBJECT_MAX}"
        )
    if m.group("rest").endswith("."):
        warnings.append("subject should not end with a period")
    if m.group("rest")[:1].isupper() and not m.group("rest").split()[0].isupper():
        warnings.append("subject should start lowercase")

    body = "\n".join(lines[1:])
    footers = {
        fm.group(1)
        for fm in re.finditer(r"^([A-Z][A-Za-z-]*):\s*\S", body, re.MULTILINE)
    }

    if ctype == "docket" and not (set(DOCKET_FOOTERS) & footers):
        warnings.append(
            "a `docket:` commit asserts something happened in the world — add "
            f"one of {', '.join(f + ':' for f in DOCKET_FOOTERS)} with the date, "
            "or use `draft:` if it has not gone out"
        )
    if ctype in SOURCE_REQUIRED and "Source" not in footers:
        warnings.append(
            f"`{ctype}:` should carry `Source:` — where the material came from "
            "is the question you will be asked about it"
        )

    return (errors, warnings)


def cmd_commit_check(args: argparse.Namespace) -> int:
    if args.list_types:
        for name, meaning in sorted(COMMIT_TYPES.items()):
            print(f"  {name:<10} {meaning}")
        return 0

    text = Path(args.message_file).read_text() if args.message_file else sys.stdin.read()
    errors, warnings = _check_commit_message(text)

    for w in warnings:
        print(f"commit-check: {w}", file=sys.stderr)
    for e in errors:
        print(f"commit-check: {e}", file=sys.stderr)
    if errors:
        print(
            "\nSee docs/commits.md. To commit anyway: git commit --no-verify",
            file=sys.stderr,
        )
        return 1
    return 0


def cmd_hooks(args: argparse.Namespace) -> int:
    """Install the matter-side git hooks into a matter directory."""
    dest = Path(args.matter_dir).expanduser().resolve()
    if not (dest / ".git").exists():
        print(f"{dest} is not a git repository; run `git init` there first.",
              file=sys.stderr)
        return 1
    hooks_src = ROOT / "templates" / "matter" / "githooks"
    hooks_dir = dest / ".githooks"
    hooks_dir.mkdir(exist_ok=True)
    for hook in hooks_src.iterdir():
        target = hooks_dir / hook.name
        shutil.copy(hook, target)
        target.chmod(0o755)
        print(f"  installed {target.relative_to(dest)}")
    subprocess.run(["git", "config", "core.hooksPath", ".githooks"],
                   cwd=dest, check=True)
    print("  git config core.hooksPath .githooks")
    return 0



