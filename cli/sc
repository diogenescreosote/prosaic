def _opener() -> list[str]:
    if _platform().startswith(("darwin", "Darwin")):
        return ["open"]
    return ["xdg-open"]


def outputs_for(matter: Path, target: str, variant: str | None = None) -> list[Path]:
    """PDFs to open for an envelope name (or a path). Newest first."""
    cand = Path(target).expanduser()
    if cand.is_file():
        return [cand.resolve()]
    if cand.is_dir():
        base = cand.resolve()
    else:
        base = matter / "out" / target
        if not base.is_dir():
            raise SystemExit(f"sc open: no out/{target}/ --- build it first (`sc build {target}`)")
    if variant:
        base = base / variant
        if not base.is_dir():
            raise SystemExit(f"sc open: no variant directory {base}")
    pdfs = [p for p in base.rglob("*.pdf") if not p.name.startswith(".")]
    if variant is None and any(p.parent != base for p in pdfs):
        # Variant subdirectories present: open the newest variant's set,
        # plus anything at the envelope root, rather than every variant.
        by_dir: dict[Path, float] = {}
        for p in pdfs:
            by_dir[p.parent] = max(by_dir.get(p.parent, 0.0), p.stat().st_mtime)
        newest = max(by_dir, key=by_dir.get)
        pdfs = [p for p in pdfs if p.parent in (base, newest)]
    return sorted(pdfs, key=lambda p: p.stat().st_mtime, reverse=True)


def cmd_open(args: argparse.Namespace) -> int:
    matter = _matter_root(Path(args.matter_dir))
    paths: list[Path] = []
    for t in args.targets:
        paths += outputs_for(matter, t, args.variant)
    if not paths:
        print("sc open: nothing to open", file=sys.stderr)
        return 1
    for p in paths:
        print(p)
    if args.print_only:
        return 0
    return subprocess.run([*_opener(), *map(str, paths)]).returncode

#: Git remote a matter backs itself up to. Never "origin": a matter has
#: no upstream it was cloned from, and reusing the name invites the
#: muscle memory of `git push` reaching somewhere it should not.
BACKUP_REMOTE = "backup"


def _matter_config(matter_dir: Path) -> dict:
    try:
        import yaml
    except ModuleNotFoundError:
        raise SystemExit("sc backup needs PyYAML.  pip install -r pleading/requirements.txt")
    cfg = matter_dir / "matter.yaml"
    if not cfg.exists():
        raise SystemExit(f"no matter.yaml in {matter_dir}")
    return yaml.safe_load(cfg.read_text()) or {}


def _github_repo_is_private(repo: str) -> bool:
    """Ask GitHub, every time — never trust the config's word for it.

    This is the check the whole GitHub backend hangs on. A matter is
    privileged material; the difference between a private repo and a
    public one is the difference between a backup and a disclosure, and
    a repo's visibility can be changed after `sc backup init` ran.
    """
    out = subprocess.run(
        ["gh", "repo", "view", repo, "--json", "isPrivate"],
        capture_output=True, text=True,
    )
    if out.returncode != 0:
        raise SystemExit(
            f"could not read {repo} from GitHub: {out.stderr.strip()}\n"
            f"Check `gh auth status`."
        )
    return bool(json.loads(out.stdout).get("isPrivate"))


def _backup_destination(matter_dir: Path, cfg: dict) -> tuple[str, str]:
    """Return (kind, git-url) for this matter's backup, or exit saying why not."""
    backup = cfg.get("backup") or {}
    kind = str(backup.get("kind") or "local")

    if kind == "local":
        path = backup.get("path")
        if path:
            dest = Path(str(path)).expanduser()
        else:
            dest = app_path("data-dir") / "backups" / f"{matter_dir.name}.git"
        return ("local", str(dest))

    if kind == "github":
        repo = backup.get("repo")
        if not repo:
            raise SystemExit(
                'backup.kind is "github" but backup.repo is not set '
                '(expected "owner/name" in matter.yaml).'
            )
        if not shutil.which("gh"):
            raise SystemExit("backup.kind is \"github\" but the `gh` CLI is not installed.")
        if not _github_repo_is_private(str(repo)):
            raise SystemExit(
                f"REFUSING: {repo} is a PUBLIC GitHub repository.\n"
                f"A matter is privileged material and is never pushed to a "
                f"public repo. Make it private, or use backup.kind: local."
            )
        return ("github", f"https://github.com/{repo}.git")

    raise SystemExit(f'unknown backup.kind {kind!r} (expected "local" or "github")')


def cmd_backup(args: argparse.Namespace) -> int:
    matter_dir = Path(args.matter_dir).expanduser().resolve()
    if not (matter_dir / ".git").exists():
        print(f"{matter_dir} is not a git repository.", file=sys.stderr)
        return 1
    cfg = _matter_config(matter_dir)

    if args.action == "status":
        backup = cfg.get("backup") or {}
        if not backup:
            print("No backup configured. Add a `backup:` block to matter.yaml, "
                  "then run `sc backup init`.")
            return 0
        kind, url = _backup_destination(matter_dir, cfg)
        print(f"  kind      {kind}")
        print(f"  target    {url}")
        remote = subprocess.run(
            ["git", "remote", "get-url", BACKUP_REMOTE],
            cwd=matter_dir, capture_output=True, text=True,
        )
        if remote.returncode != 0:
            print(f"  remote    not configured — run `sc backup init {matter_dir}`")
            return 0
        print(f"  remote    {remote.stdout.strip()}")
        branch = subprocess.run(
            ["git", "rev-parse", "--abbrev-ref", "HEAD"],
            cwd=matter_dir, capture_output=True, text=True, check=True,
        ).stdout.strip()
        ahead = subprocess.run(
            ["git", "rev-list", "--count", f"{BACKUP_REMOTE}/{branch}..HEAD"],
            cwd=matter_dir, capture_output=True, text=True,
        )
        if ahead.returncode != 0:
            print("  unpushed  unknown — nothing pushed to this remote yet")
        else:
            n = ahead.stdout.strip()
            print("  unpushed  none" if n == "0" else f"  unpushed  {n} commit(s)")
        return 0

    kind, url = _backup_destination(matter_dir, cfg)

    if args.action == "init":
        if kind == "local":
            dest = Path(url)
            if not dest.exists():
                dest.parent.mkdir(parents=True, exist_ok=True)
                subprocess.run(["git", "init", "--bare", "-q", str(dest)], check=True)
                print(f"  created bare repository {dest}")
            else:
                print(f"  using existing {dest}")
        else:
            print(f"  target {url} (verified private)")
        existing = subprocess.run(
            ["git", "remote", "get-url", BACKUP_REMOTE],
            cwd=matter_dir, capture_output=True, text=True,
        )
        verb = "set-url" if existing.returncode == 0 else "add"
        subprocess.run(["git", "remote", verb, BACKUP_REMOTE, url],
                       cwd=matter_dir, check=True)
        print(f"  remote {BACKUP_REMOTE} -> {url}")
        hook = matter_dir / ".githooks" / "post-commit"
        if not hook.exists():
            print("  note: no post-commit hook — run `sc hooks` to back up "
                  "automatically after each commit")
        return 0

    # push
    branch = subprocess.run(
        ["git", "rev-parse", "--abbrev-ref", "HEAD"],
        cwd=matter_dir, capture_output=True, text=True, check=True,
    ).stdout.strip()
    result = subprocess.run(
        ["git", "push", BACKUP_REMOTE, branch],
        cwd=matter_dir, capture_output=True, text=True,
    )
    if result.returncode != 0:
        print(f"backup push failed: {result.stderr.strip()}", file=sys.stderr)
        return 1
    print(f"  backed up {branch} -> {url}")
    return 0


def cmd_schedule(args: argparse.Namespace) -> int:
    cmd = ["/bin/bash", str(ROOT / "sync" / "install_schedule.sh"), str(Path(args.matter_dir).resolve())]
    if args.times:
