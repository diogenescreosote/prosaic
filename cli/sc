def _opener() -> list[str]:
    if _platform().startswith(("darwin", "Darwin")):
        return ["open"]
    return ["xdg-open"]


def outputs_for(matter: Path, target: str, variant: str | None = None) -> list[Path]:
    """PDFs to open for an envelope name (or a path). Newest first."""
    cand = Path(target).expanduser()
    if cand.is_file():
        return [cand.resolve()]
    if cand.is_dir():
        base = cand.resolve()
    else:
        base = matter / "out" / target
        if not base.is_dir():
            raise SystemExit(f"sc open: no out/{target}/ --- build it first (`sc build {target}`)")
    if variant:
        base = base / variant
        if not base.is_dir():
            raise SystemExit(f"sc open: no variant directory {base}")
    pdfs = [p for p in base.rglob("*.pdf") if not p.name.startswith(".")]
    if variant is None and any(p.parent != base for p in pdfs):
        # Variant subdirectories present: open the newest variant's set,
        # plus anything at the envelope root, rather than every variant.
        by_dir: dict[Path, float] = {}
        for p in pdfs:
            by_dir[p.parent] = max(by_dir.get(p.parent, 0.0), p.stat().st_mtime)
        newest = max(by_dir, key=by_dir.get)
        pdfs = [p for p in pdfs if p.parent in (base, newest)]
    return sorted(pdfs, key=lambda p: p.stat().st_mtime, reverse=True)


def cmd_open(args: argparse.Namespace) -> int:
    matter = _matter_root(Path(args.matter_dir))
    paths: list[Path] = []
    for t in args.targets:
        paths += outputs_for(matter, t, args.variant)
    if not paths:
        print("sc open: nothing to open", file=sys.stderr)
        return 1
    for p in paths:
        print(p)
    if args.print_only:
        return 0
    return subprocess.run([*_opener(), *map(str, paths)]).returncode

#: Git remote a matter backs itself up to. Never "origin": a matter has
#: no upstream it was cloned from, and reusing the name invites the
#: muscle memory of `git push` reaching somewhere it should not.
BACKUP_REMOTE = "backup"


def _matter_config(matter_dir: Path) -> dict:
    try:
        import yaml
    except ModuleNotFoundError:
        raise SystemExit("sc backup needs PyYAML.  pip install -r pleading/requirements.txt")
    cfg = matter_dir / "matter.yaml"
    if not cfg.exists():
        raise SystemExit(f"no matter.yaml in {matter_dir}")
    return yaml.safe_load(cfg.read_text()) or {}


def _github_repo_is_private(repo: str) -> bool:
    """Ask GitHub, every time — never trust the config's word for it.

    This is the check the whole GitHub backend hangs on. A matter is
    privileged material; the difference between a private repo and a
    public one is the difference between a backup and a disclosure, and
    a repo's visibility can be changed after `sc backup init` ran.
    """
    out = subprocess.run(
        ["gh", "repo", "view", repo, "--json", "isPrivate"],
        capture_output=True, text=True,
    )
    if out.returncode != 0:
        raise SystemExit(
            f"could not read {repo} from GitHub: {out.stderr.strip()}\n"
            f"Check `gh auth status`."
        )
    return bool(json.loads(out.stdout).get("isPrivate"))


def _backup_destination(matter_dir: Path, cfg: dict) -> tuple[str, str]:
    """Return (kind, git-url) for this matter's backup, or exit saying why not."""
    backup = cfg.get("backup") or {}
    kind = str(backup.get("kind") or "local")

    if kind == "local":
        path = backup.get("path")
        if path:
            dest = Path(str(path)).expanduser()
        else:
            dest = app_path("data-dir") / "backups" / f"{matter_dir.name}.git"
        return ("local", str(dest))

    if kind == "github":
        repo = backup.get("repo")
        if not repo:
            raise SystemExit(
                'backup.kind is "github" but backup.repo is not set '
                '(expected "owner/name" in matter.yaml).'
            )
        if not shutil.which("gh"):
            raise SystemExit("backup.kind is \"github\" but the `gh` CLI is not installed.")
        if not _github_repo_is_private(str(repo)):
            raise SystemExit(
                f"REFUSING: {repo} is a PUBLIC GitHub repository.\n"
                f"A matter is privileged material and is never pushed to a "
                f"public repo. Make it private, or use backup.kind: local."
            )
        return ("github", f"https://github.com/{repo}.git")

    raise SystemExit(f'unknown backup.kind {kind!r} (expected "local" or "github")')


def cmd_backup(args: argparse.Namespace) -> int:
    matter_dir = Path(args.matter_dir).expanduser().resolve()
    if not (matter_dir / ".git").exists():
        print(f"{matter_dir} is not a git repository.", file=sys.stderr)
        return 1
    cfg = _matter_config(matter_dir)

    if args.action == "status":
        backup = cfg.get("backup") or {}
        if not backup:
            print("No backup configured. Add a `backup:` block to matter.yaml, "
                  "then run `sc backup init`.")
            return 0
        kind, url = _backup_destination(matter_dir, cfg)
        print(f"  kind      {kind}")
        print(f"  target    {url}")
        remote = subprocess.run(
            ["git", "remote", "get-url", BACKUP_REMOTE],
            cwd=matter_dir, capture_output=True, text=True,
        )
        if remote.returncode != 0:
            print(f"  remote    not configured — run `sc backup init {matter_dir}`")
            return 0
        print(f"  remote    {remote.stdout.strip()}")
        branch = subprocess.run(
            ["git", "rev-parse", "--abbrev-ref", "HEAD"],
            cwd=matter_dir, capture_output=True, text=True, check=True,
        ).stdout.strip()
        ahead = subprocess.run(
            ["git", "rev-list", "--count", f"{BACKUP_REMOTE}/{branch}..HEAD"],
            cwd=matter_dir, capture_output=True, text=True,
        )
        if ahead.returncode != 0:
            print("  unpushed  unknown — nothing pushed to this remote yet")
        else:
            n = ahead.stdout.strip()
            print("  unpushed  none" if n == "0" else f"  unpushed  {n} commit(s)")
        return 0

    kind, url = _backup_destination(matter_dir, cfg)

    if args.action == "init":
        if kind == "local":
            dest = Path(url)
            if not dest.exists():
                dest.parent.mkdir(parents=True, exist_ok=True)
                subprocess.run(["git", "init", "--bare", "-q", str(dest)], check=True)
                print(f"  created bare repository {dest}")
            else:
                print(f"  using existing {dest}")
        else:
            print(f"  target {url} (verified private)")
        existing = subprocess.run(
            ["git", "remote", "get-url", BACKUP_REMOTE],
            cwd=matter_dir, capture_output=True, text=True,
        )
        verb = "set-url" if existing.returncode == 0 else "add"
        subprocess.run(["git", "remote", verb, BACKUP_REMOTE, url],
                       cwd=matter_dir, check=True)
        print(f"  remote {BACKUP_REMOTE} -> {url}")
        hook = matter_dir / ".githooks" / "post-commit"
        if not hook.exists():
            print("  note: no post-commit hook — run `sc hooks` to back up "
                  "automatically after each commit")
        return 0

    # push
    branch = subprocess.run(
        ["git", "rev-parse", "--abbrev-ref", "HEAD"],
        cwd=matter_dir, capture_output=True, text=True, check=True,
    ).stdout.strip()
    result = subprocess.run(
        ["git", "push", BACKUP_REMOTE, branch],
        cwd=matter_dir, capture_output=True, text=True,
    )
    if result.returncode != 0:
        print(f"backup push failed: {result.stderr.strip()}", file=sys.stderr)
        return 1
    print(f"  backed up {branch} -> {url}")
    return 0


def cmd_schedule(args: argparse.Namespace) -> int:
    cmd = ["/bin/bash", str(ROOT / "sync" / "install_schedule.sh"), str(Path(args.matter_dir).resolve())]
    if args.times:
        cmd += args.times
    return subprocess.run(cmd).returncode


def main() -> int:
    p = argparse.ArgumentParser(prog="sc", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="command", required=True)

    sp = sub.add_parser("init", help="scaffold a new matter directory")
    sp.add_argument("matter_dir")
    sp.add_argument("--force", action="store_true", help="overwrite existing template files")
    sp.add_argument("--git", action="store_true", help="git init the matter")
    sp.set_defaults(func=cmd_init)

    sp = sub.add_parser("sync", help="run configured connectors + AI triage now")
    sp.add_argument("matter_dir")
    sp.add_argument("--scheduled", action="store_true", help=argparse.SUPPRESS)
    sp.set_defaults(func=cmd_sync)

    sp = sub.add_parser("build", help="build a filing envelope (run from the matter dir)")
    sp.add_argument("--final", action="store_true",
                    help="suppress the default DRAFT banner: this build goes into the world")
    sp.add_argument("envelope", nargs="?",
                    help="envelope name from envelopes.yaml (or pass --all)")
    sp.add_argument("--all", action="store_true",
                    help="every envelope not marked sent (--force includes sent ones)")
    sp.add_argument("--check-stale", action="store_true",
                    help="build nothing; fail if any output is missing or stale")
    sp.add_argument("--force", action="store_true")
    sp.add_argument("--variant", choices=["sealed", "public"])
    sp.add_argument("--sign", metavar="NAME")
    sp.add_argument("--date", metavar="YYYY-MM-DD")
    sp.set_defaults(func=cmd_build)

    sp = sub.add_parser("build-doc",
                        help="build exactly one envelope-owned Markdown source "
                             "(run from the matter dir; ADR-0039)")
    sp.add_argument("source",
                    help="source path, e.g. src/declaration.md")
    sp.add_argument("--final", action="store_true",
                    help="suppress the default DRAFT banner: this build goes into the world")
    sp.add_argument("--force", action="store_true",
                    help="rebuild even if current, or if the owning envelope is sent")
    sp.add_argument("--variant", choices=["sealed", "public"])
    sp.add_argument("--sign", metavar="NAME")
    sp.add_argument("--date", metavar="YYYY-MM-DD")
    sp.set_defaults(func=cmd_build_doc)

    sp = sub.add_parser("list", help="list envelopes (run from the matter dir)")
    sp.set_defaults(func=cmd_list)

    sp = sub.add_parser("ocr", help="OCR-supplement one PDF into an output dir")
    sp.add_argument("pdf")
    sp.add_argument("outdir")
    sp.set_defaults(func=cmd_ocr)

    sp = sub.add_parser("form", help="JC form operations: list, info, fill, fields")
    sp.add_argument("rest", nargs=argparse.REMAINDER,
                    help="passed through to pleading/form_fill.py")
    sp.set_defaults(func=cmd_form)

    sp = sub.add_parser("attest", help="cryptographic attestation: hash, sign, verify, manifest, timestamp")
    sp.add_argument("rest", nargs=argparse.REMAINDER,
                    help="passed through to crypto/attest.py")
    sp.set_defaults(func=cmd_attest)

    sp = sub.add_parser("flow", help="run a files-first flow (agent/judge/gate steps)")
    sp.add_argument("rest", nargs=argparse.REMAINDER,
                    help="passed through to flows/run.py")
    sp.set_defaults(func=cmd_flow)

    sp = sub.add_parser("proof", help="remote online notarization via Proof: send, status, fetch, poll")
    sp.add_argument("rest", nargs=argparse.REMAINDER,
                    help="passed through to proof-client/client.py")
    sp.set_defaults(func=cmd_proof)

    sp = sub.add_parser("docuseal", help="e-signature via DocuSeal: send, status, fetch")
    sp.add_argument("rest", nargs=argparse.REMAINDER,
                    help="passed through to docuseal-client/client.py")
    sp.set_defaults(func=cmd_docuseal)

    sp = sub.add_parser("sign", help="local signing + attestation: slots, marks, apply, verify")
    sp.add_argument("rest", nargs=argparse.REMAINDER,
                    help="passed through to signing/sign.py")
    sp.set_defaults(func=cmd_sign)

    sp = sub.add_parser("connectors", help="list available connectors")
    sp.set_defaults(func=cmd_connectors)

    sp = sub.add_parser("paths", help="print an application directory")
    sp.add_argument("kind", choices=PATH_KINDS)
    sp.set_defaults(func=cmd_paths)

    sp = sub.add_parser("mail-render",
                        help="re-render a stored gmail thread mbox: PDF, .eml, attachments")
    sp.add_argument("rest", nargs=argparse.REMAINDER,
                    help="passed through to connectors/gmail/render.js")
    sp.set_defaults(func=cmd_mail_render)

    sp = sub.add_parser("harness", help="install the coding-agent harness bundle (.claude/) in a matter")
    sp.add_argument("action", choices=("install",))
    sp.add_argument("matter_dir", nargs="?", default=".")
    sp.set_defaults(func=cmd_harness)

    sp = sub.add_parser("find", help="grep the record for terms; list every document that could not be searched (exit 2)")
    sp.add_argument("terms", nargs="*")
    sp.add_argument("--checklist", action="store_true",
                    help="always write the per-file checklist (automatic above %d files)" % CHECKLIST_ABOVE_FILES)
    sp.add_argument("--verify", metavar="CHECKLIST",
                    help="check a marked checklist; exit 3 while any file is neither read nor skipped")
    sp.add_argument("--matter-dir", default=".", dest="matter_dir")
    sp.add_argument("--per-file", type=int, default=12, help="max hit lines shown per file")
    sp.add_argument("-F", "--fixed", action="store_true", help="literal terms, not regex")
    sp.add_argument("--ensure", action="store_true",
                    help="run `sc text ensure` first so sidecars exist before searching")
    sp.add_argument("--all", action="store_true",
                    help="with several terms, keep only files that contain every term")
    sp.add_argument("--scope", action="append", metavar="DIR",
                    help="search only this directory (repeatable), e.g. --scope pleadings --scope src")
    sp.add_argument("--this-matter-only", action="store_true",
                    help="do not search the matters listed under related_matters in matter.yaml")
    sp.add_argument("--summary", action="store_true",
                    help="files with hit counts only (automatic above %d files)" % SUMMARY_ABOVE_FILES)
    sp.add_argument("--full", action="store_true", help="snippets even for a broad term")
    sp.add_argument("--max-files", type=int, default=60, help="files listed in summary mode")
    sp.set_defaults(func=cmd_find)

    sp = sub.add_parser("text", help="text coverage: audit or ensure that every document is searchable")
    sp.add_argument("action", choices=("audit", "ensure", "migrate"))
    sp.add_argument("matter_dir", nargs="?", default=".")
    sp.add_argument("--json", action="store_true")
    sp.add_argument("--include-legacy-ocr", action="store_true",
                    help="migrate: also move _ocr.pdf siblings the tool did not make")
    sp.add_argument("--include-inbox", action="store_true", help="also cover inbox/ (normally triage first)")
    sp.add_argument("--no-cache", action="store_true", help="re-survey every document")
    sp.add_argument("--dry-run", action="store_true", help="ensure: report what would be repaired")
    sp.add_argument("--redo-ocr", action="store_true",
                    help="ensure: regenerate an _ocr sibling that still has uncovered pages")
    sp.add_argument("--jobs", type=int, default=2)
    sp.set_defaults(func=cmd_text)

    sp = sub.add_parser("knowledge", help="the knowledge vault: init, new, check, index, migrate (ADR-0043)")
    sp.add_argument("action", choices=("init", "new", "check", "index", "migrate"))
    sp.add_argument("matter_dir", nargs="?", default=".")
    sp.add_argument("--migrate", action="store_true", help="init: split a legacy KNOWLEDGE.md into staging")
    sp.add_argument("--fix", action="store_true", help="check: regenerate the index first")
    sp.add_argument("--type", choices=("person", "organization", "event", "topic", "issue", "filing"))
    sp.add_argument("--title")
    sp.add_argument("--alias", action="append", default=[])
    sp.set_defaults(func=cmd_knowledge)

    sp = sub.add_parser("upgrade", help="bring an existing matter onto current conventions (idempotent)")
    sp.add_argument("matter_dir", nargs="?", default=".")
    sp.add_argument("--dry-run", action="store_true")
    sp.add_argument("--jobs", type=int, default=2)
    sp.set_defaults(func=cmd_upgrade)

    sp = sub.add_parser("review", help="preflight review plumbing: paths, cites, report, status (ADR-0045; optional, never a gate)")
    sp.add_argument("action", choices=("paths", "cites", "report", "status", "second-opinion"))
    sp.add_argument("target", nargs="?", help="envelope name or src/ path")
    sp.add_argument("--brief", help="second-opinion: one paragraph on what the draft must achieve")
    sp.add_argument("--matter-dir", default=".", dest="matter_dir")
    sp.add_argument("--check", help="report: the check name (citecheck, clerkreview, judgereview, oppo, preflight)")
    sp.add_argument("--tidy", action="store_true", help="status: move stale reports into superseded/")
    sp.set_defaults(func=cmd_review)

    sp = sub.add_parser("refine", help="nightly knowledge refinement: proposals and questions, never edits (ADR-0044)")
    sp.add_argument("matter_dir", nargs="?", default=".")
    sp.add_argument("--since-days", type=int, default=1)
    sp.add_argument("--inputs-only", action="store_true", help="gather inputs; run no agent")
    sp.add_argument("--scheduled", action="store_true", help="skip if today's proposal exists")
    sp.set_defaults(func=cmd_refine)

    sp = sub.add_parser("standup", help="write the morning standup agenda (derived/standup/<date>.md)")
    sp.add_argument("action", choices=("agenda",))
    sp.add_argument("matter_dir", nargs="?", default=".")
    sp.add_argument("--notify", action="store_true", help="post a desktop notification (macOS)")
    sp.set_defaults(func=cmd_standup)

    sp = sub.add_parser("brief", help="print a short matter brief for a session start")
    sp.add_argument("matter_dir", nargs="?", default=".")
    sp.add_argument("--todo", type=int, default=8, help="TODO items to show")
    sp.add_argument("--dates", type=int, default=10, help="calendar lines to show")
    sp.set_defaults(func=cmd_brief)

    sp = sub.add_parser("open", help="open an envelope's built PDFs (or paths) in the viewer")
    sp.add_argument("targets", nargs="+", help="envelope name(s) or file/dir path(s)")
    sp.add_argument("--variant", help="open this variant subdirectory only")
    sp.add_argument("--matter-dir", default=".", dest="matter_dir")
    sp.add_argument("--print-only", action="store_true", help="list paths, do not launch a viewer")
    sp.set_defaults(func=cmd_open)

    sp = sub.add_parser("clean", help="report stale files in out/ (--apply removes)")
    sp.add_argument("matter_dir", nargs="?", default=".")
    sp.add_argument("--apply", action="store_true",
                    help="actually delete them (default: report only)")
    sp.add_argument("--older-than", type=int, metavar="DAYS", dest="older_than",
                    help="instead: files older than DAYS under out/, .flow/, derived/find|refine|standup")
    sp.set_defaults(func=cmd_clean)

    sp = sub.add_parser("backup", help="back a matter up to its configured upstream")
    sp.add_argument("action", choices=("init", "push", "status"))
    sp.add_argument("matter_dir", nargs="?", default=".")
    sp.set_defaults(func=cmd_backup)

    sp = sub.add_parser("commit-check", help="validate a matter commit message")
    sp.add_argument("message_file", nargs="?",
                    help="file holding the message (default: stdin)")
    sp.add_argument("--list-types", action="store_true",
                    help="print the commit types and what they mean")
    sp.set_defaults(func=cmd_commit_check)

    sp = sub.add_parser("hooks", help="install the matter git hooks")
    sp.add_argument("matter_dir")
    sp.set_defaults(func=cmd_hooks)

    sp = sub.add_parser("deps", help="report or list the system dependencies")
    sp.add_argument(
        "--format",
        choices=("check", "apt", "brew"),
        default="check",
        help="check what's installed (default), or emit a package list",
    )
    sp.set_defaults(func=cmd_deps)

    sp = sub.add_parser("schedule", help="install the standby supervisor: sync, inbox watcher, nightly refine, standup agenda (macOS)")
    sp.add_argument("matter_dir")
    sp.add_argument("times", nargs="*", help="two HH:MM firing times (default 08:00 20:00)")
    sp.set_defaults(func=cmd_schedule)

    args = p.parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
