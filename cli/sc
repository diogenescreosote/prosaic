def _text_coverage():
    sys.path.insert(0, str(ROOT / "triage"))
    import text_coverage  # noqa: E402
    return text_coverage


def cmd_text(args: argparse.Namespace) -> int:
    tc = _text_coverage()
    matter = _matter_root(Path(args.matter_dir))
    if args.action == "migrate":
        for m in tc.migrate(matter, dry_run=args.dry_run, include_legacy_ocr=args.include_legacy_ocr):
            print(m)
        return 0
    if args.action == "audit":
        docs = tc.audit(matter, include_inbox=args.include_inbox, use_cache=not args.no_cache)
    else:
        docs = tc.ensure(matter, include_inbox=args.include_inbox, dry_run=args.dry_run,
                         redo_ocr=args.redo_ocr, jobs=args.jobs)
    if args.json:
        print(json.dumps([tc.asdict(d) for d in docs], indent=1))
    else:
        sys.stdout.write(tc.format_audit(docs))
    return 0 if all(d.searched or d.state == "untriaged" for d in docs) else 1


# ---------------------------------------------------------------------------
# find: the deterministic first tier of record search
# ---------------------------------------------------------------------------

#: Text the record can be grepped through. PDFs are searched through
#: their text sidecars; a PDF with no sidecar is reported, never skipped
#: silently --- a document that was not searched is not a document that
#: says nothing.
FIND_GLOBS = ("*.md", "*.txt", "*.yaml", "*.yml", "*.json", "*.csv", "*.srt", "*.eml", "*.html")
FIND_EXCLUDE_DIRS = ("out", ".state", ".git", ".flow", "node_modules", ".claude")


def find_in_matter(matter: Path, terms: list[str], per_file: int = 12,
                   fixed: bool = False, docs=None, require_all: bool = False) -> dict:
    """ripgrep every term over the matter's text; every document the
    coverage audit says is not searchable is listed as UNSEARCHED with
    its reason. Returns a structured report."""
    rg = shutil.which("rg")
    report: dict = {"terms": {}, "unsearched": [], "searched_files": 0, "tool": rg or "grep",
                    "coverage": ""}
    excludes: list[str] = []
    for d in FIND_EXCLUDE_DIRS:
        excludes += ["--glob", f"!{d}/**"]
    for term in terms:
        hits: dict[str, list[str]] = {}
        if rg:
            # rg applies globs in order and the last match wins, so the
            # directory exclusions must come after the type globs.
            cmd = [rg, "-n", "-i", "--no-heading", "--color", "never",
                   "--max-count", str(per_file)]
            for g in FIND_GLOBS:
                cmd += ["--glob", g]
            cmd += excludes
            cmd += ["-F"] if fixed else []
            cmd += ["-e", term, "."]
            proc = subprocess.run(cmd, cwd=matter, capture_output=True, text=True, errors="replace")
            out = proc.stdout
        else:
            cmd = ["grep", "-r", "-n", "-i", "-I", *(["-F"] if fixed else []),
                   *[f"--exclude-dir={d}" for d in FIND_EXCLUDE_DIRS], "-e", term, "."]
            proc = subprocess.run(cmd, cwd=matter, capture_output=True, text=True, errors="replace")
            out = proc.stdout
        for ln in out.splitlines():
            path, _, rest = ln.partition(":")
            path = path[2:] if path.startswith("./") else path
            hits.setdefault(path, []).append(rest[:300])
        report["terms"][term] = hits
    if require_all and len(terms) > 1:
        # Narrowing: keep only files that carry every term. The grep is
        # per line, so a document mentioning both terms on different
        # pages still qualifies, which is the right unit for a record.
        common = set.intersection(*(set(h) for h in report["terms"].values()))
        for term in terms:
            report["terms"][term] = {p: v for p, v in report["terms"][term].items() if p in common}
        report["require_all"] = sorted(common)
    # what could not be searched: the coverage audit decides, so a PDF
    # with an _ocr sibling but no .txt, or a stale sidecar, is never
    # counted as searched just because a file with the right name exists.
    if docs is None:
        docs = _text_coverage().audit(matter)
    tc = _text_coverage()
    report["coverage"] = tc.coverage_line(docs)
    report["unsearched"] = sorted(
        f"[{d.state}] {d.path}" + (f" --- {d.note}" if d.note else "")
        for d in docs if not d.searched and d.state != "untriaged")
    report["untriaged"] = sorted(d.path for d in docs if d.state == "untriaged")
    n_text = 0
    for f in matter.rglob("*"):
        if not f.is_file() or any(part in FIND_EXCLUDE_DIRS for part in f.relative_to(matter).parts):
            continue
        if any(f.match(g) for g in FIND_GLOBS):
            n_text += 1
    report["searched_files"] = n_text
    return report


def _page_index(text_file: Path) -> list[int]:
    """Line number (1-based index) -> page, from `[[[ page k of N ]]]` markers."""
    pages: list[int] = [0]
    cur = 0
    try:
        for ln in text_file.open(encoding="utf-8", errors="replace"):
            if ln.startswith("[[[ page "):
                try:
                    cur = int(ln.split()[2])
                except (IndexError, ValueError):
                    pass
            pages.append(cur)
    except OSError:
        pass
    return pages


#: Above this many files a term is broad, and a page of snippets per file
#: would cost the reading model tens of thousands of tokens (a party's
#: surname on a live matter: 452 files, 59k tokens). Broad terms get a
#: summary: files with counts, capped, and the advice to narrow.
SUMMARY_ABOVE_FILES = 40
#: Above this many files a checklist is written even when snippets are
#: shown: a reader given twenty-five files reads the top few and stops
#: unless every file must be marked read or skipped with a reason.
CHECKLIST_ABOVE_FILES = 10


def _original_of(path: str) -> str:
    if path.startswith("derived/text/") and path.endswith(".txt"):
        return path[len("derived/text/"):-len(".txt")]
    return path


def format_find(report: dict, show_unsearched: int = 40, matter: Path | None = None,
                summary: bool | None = None, max_files: int = 60) -> str:
    """Hits under derived/text/ are shown as the original document with a
    page number, so a hit is a cite, not a path into a cache. Broad terms
    (more than SUMMARY_ABOVE_FILES files, or --summary) list files with hit
    counts instead of snippets, capped at max_files."""
    lines: list[str] = []
    if "require_all" in report:
        lines.append(f"## files carrying every term: {len(report['require_all'])}")
        lines.append("")
    for term, hits in report["terms"].items():
        total = sum(len(v) for v in hits.values())
        lines.append(f"## {term!r}: {total} hit line(s) in {len(hits)} file(s)")
        use_summary = summary if summary is not None else len(hits) > SUMMARY_ABOVE_FILES
        if use_summary:
            ranked = sorted(hits.items(), key=lambda kv: (-len(kv[1]), kv[0]))
            by_dir: dict[str, int] = {}
            for path, hs in ranked:
                top = _original_of(path).split("/")[0]
                by_dir[top] = by_dir.get(top, 0) + 1
            lines.append("files by directory: " + ", ".join(f"{d} {n}" for d, n in sorted(by_dir.items(), key=lambda kv: -kv[1])))
            for path, hs in ranked[:max_files]:
                lines.append(f"- {_original_of(path)} ({len(hs)})")
            if len(ranked) > max_files:
                lines.append(f"  ... and {len(ranked) - max_files} more file(s)")
            lines.append("(summary: broad term; narrow it, add a second term, or pass "
                         "--per-file/--max-files to see snippets)")
            lines.append("")
            continue
        for path in sorted(hits):
            derived = path.startswith("derived/text/") and path.endswith(".txt")
            if derived:
                original = path[len("derived/text/"):-len(".txt")]
                lines.append(f"- {original}  (text at {path})")
                index = _page_index(matter / path) if matter else []
            else:
                lines.append(f"- {path}")
                index = []
            for h in hits[path]:
                if index:
                    lno, _, rest = h.partition(":")
                    try:
                        pg = index[int(lno)]
                        lines.append(f"    p.{pg} L{lno}: {rest}")
                        continue
                    except (ValueError, IndexError):
                        pass
                lines.append(f"    {h}")
        lines.append("")
    un = report["unsearched"]
    lines.append(f"Searched {report['searched_files']} text file(s) with {report['tool']}. "
                 f"{report.get('coverage', '')}")
    lines.append(f"UNSEARCHED: {len(un)} document(s)" + (":" if un else "."))
    for u in un[:show_unsearched]:
        lines.append(f"  - {u}")
    if len(un) > show_unsearched:
        lines.append(f"  ... and {len(un) - show_unsearched} more (sc text audit for all)")
    untri = report.get("untriaged") or []
    if untri:
        lines.append(f"UNTRIAGED (inbox/, not searched): {len(untri)} file(s)")
    return "\n".join(lines) + "\n"


def write_find_checklist(matter: Path, terms: list[str], reports: list[tuple[Path, dict]]) -> Path:
    """One line per file that hit, to be marked read or skipped with a
    reason before an answer is given. The gap this closes: at seventy
    hits a model triages by filename and says nothing about it; the
    checklist makes every dismissal explicit and auditable."""
    import datetime as dt
    import re
    out_dir = matter / "derived" / "find"
    out_dir.mkdir(parents=True, exist_ok=True)
    stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    slug = re.sub(r"[^a-z0-9]+", "-", " ".join(terms).lower()).strip("-")[:40] or "search"
    path = out_dir / f"{stamp}_{slug}.md"
    lines = [f"# find checklist: {' | '.join(terms)}",
             f"matter: {matter.name}; generated {dt.datetime.now().isoformat(timespec='seconds')}",
             "",
             "Mark every line before answering: replace `[ ]` with `[read]` or",
             "`[skip: <reason>]`. Then run `sc find --verify <this file>`; it fails",
             "while any line is unmarked. A skip on filename alone must say so.",
             ""]
    seen: set[str] = set()
    for m, report in reports:
        files: dict[str, int] = {}
        for term, hits in report["terms"].items():
            for f, hs in hits.items():
                files[f] = files.get(f, 0) + len(hs)
        if not files:
            continue
        lines.append(f"## {m.name}")
        for f, n in sorted(files.items(), key=lambda kv: (-kv[1], kv[0])):
            key = f"{m.name}:{f}"
            if key in seen:
                continue
            seen.add(key)
            lines.append(f"- [ ] {_original_of(f)} ({n})")
        lines.append("")
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")
    return path


def verify_find_checklist(path: Path) -> tuple[int, int, int, list[str]]:
    """(unmarked, read, skipped, skip reasons)."""
    import re
    unmarked = read = skipped = 0
    reasons: list[str] = []
    for ln in path.read_text(encoding="utf-8", errors="replace").splitlines():
        st = ln.strip()
        if not st.startswith("- ["):
            continue
        if st.startswith("- [ ]"):
            unmarked += 1
        elif st.startswith("- [read]"):
            read += 1
        else:
            mm = re.match(r"- \[skip:\s*(.*?)\]\s+(.*)$", st)
            if mm:
                skipped += 1
                reasons.append(f"{mm.group(2)} --- {mm.group(1)}")
            else:
                unmarked += 1  # a malformed mark counts as not done
    return unmarked, read, skipped, reasons


def _entity_hits(matter: Path, terms: list[str]) -> list[str]:
    """Tier one of search: the knowledge vault's alias index."""
    ent = matter / "derived" / "knowledge" / "entities.json"
    if not ent.is_file():
        return []
    try:
        data = json.loads(ent.read_text())
    except json.JSONDecodeError:
        return []
    out: list[str] = []
    for term in terms:
        t = term.lower()
        stems = sorted({s for alias, ss in data.get("aliases", {}).items() if t in alias for s in ss})
        for st in stems:
            info = data["notes"].get(st, {})
            out.append(f"- [[{st}]] ({info.get('type', '?')}: {info.get('title', st)}) --- {info.get('path', '')}")
    return out


def related_matters(matter: Path) -> list[Path]:
    """Matters whose records bear on this one, declared in matter.yaml:

        related_matters:
          - ../other-matter   # a related matter with an overlapping record

    A fact about a shared party can live in either record. A search that
    stops at one matter's edge reports absence for the wrong reason; the
    failure that motivated this was a Bates-stamped production sitting in
    the neighbouring matter."""
    import yaml
    cfg = yaml.safe_load((matter / "matter.yaml").read_text()) or {}
    out: list[Path] = []
    for rel in cfg.get("related_matters") or []:
        p = (matter / str(rel)).resolve()
        if (p / "matter.yaml").is_file():
            out.append(p)
        else:
            print(f"sc find: related matter {rel} has no matter.yaml; skipped", file=sys.stderr)
    return out


def cmd_find(args: argparse.Namespace) -> int:
    """Exit 0: hits and everything searchable. 1: no hits. 2: something
    was not searchable (whatever the hits) --- the caller must not read
    silence as absence. 3 (--verify): a checklist still has unmarked
    files. Related matters (matter.yaml related_matters:) are searched
    too unless --this-matter-only."""
    if not args.terms and not args.verify:
        print("sc find: give at least one term, or --verify CHECKLIST", file=sys.stderr)
        return 2
    if args.verify:
        unmarked, read, skipped, reasons = verify_find_checklist(Path(args.verify))
        print(f"checklist {args.verify}: {read} read, {skipped} skipped, {unmarked} unmarked")
        for r in reasons:
            print(f"  skip: {r}")
        if unmarked:
            print(f"NOT DONE: {unmarked} file(s) neither read nor skipped with a reason. "
                  "No answer about the record yet.")
            return 3
        return 0
    matter = _matter_root(Path(args.matter_dir))
    tc = _text_coverage()
    targets = [matter] + ([] if args.this_matter_only else related_matters(matter))
    any_hits = False
    any_gap = False
    summary = True if args.summary else (False if args.full else None)
    reports: list[tuple[Path, dict]] = []
    summarized = False
    for i, m in enumerate(targets):
        docs = tc.ensure(m, jobs=2) if args.ensure else tc.audit(m)
        if len(targets) > 1:
            sys.stdout.write(("\n" if i else "") + f"# Matter: {m.name}" + ("" if i == 0 else " (related)") + "\n\n")
        ents = _entity_hits(m, args.terms)
        if ents:
            sys.stdout.write("## Knowledge notes (alias index)\n" + "\n".join(ents) + "\n\n")
        report = find_in_matter(m, args.terms, per_file=args.per_file, fixed=args.fixed, docs=docs,
                                require_all=args.all)
        sys.stdout.write(format_find(report, matter=m, summary=summary, max_files=args.max_files))
        reports.append((m, report))
        if summary is True or (summary is None and any(len(h) > SUMMARY_ABOVE_FILES for h in report["terms"].values())):
            summarized = True
        any_hits = any_hits or any(report["terms"].values())
        any_gap = any_gap or bool(report["unsearched"])
    many = any(len(h) > CHECKLIST_ABOVE_FILES for _, r in reports for h in r["terms"].values())
    if any_hits and (summarized or many or args.checklist):
        cl = write_find_checklist(matter, args.terms, reports)
        n = sum(1 for ln in cl.read_text().splitlines() if ln.startswith("- [ ]"))
        sys.stdout.write(f"\nCHECKLIST: {cl.relative_to(matter)} --- {n} file(s). Mark each `[read]` or "
                         f"`[skip: reason]`, then `sc find --verify {cl.relative_to(matter)}` "
                         "must pass before any answer about the record.\n")
    if any_gap:
        return 2
    return 0 if any_hits else 1


