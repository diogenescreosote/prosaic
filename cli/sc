import hashlib
import re as _re

#: Citation forms the extractor recognizes. Deterministic and deliberately
#: over-inclusive: a false positive costs one row a reader dismisses; a
#: missed cite is the failure the check exists to prevent.
CITE_PATTERNS = [
    ("statute", _re.compile(r"\b((?:Fam\.|Civ\.|Evid\.|Pen\.|Prob\.|Gov\.|Bus\. & Prof\.|Health & Saf\.|Welf\. & Inst\.|Ins\.|Lab\.|Veh\.)\s*Code,?\s*(?:§§?|sections?|secs?\.)\s*[\d.]+(?:\([a-z0-9]+\))*(?:\s*(?:-|--|–|—|through|to|and|,)\s*[\d.]+(?:\([a-z0-9]+\))*)*)")),
    ("statute", _re.compile(r"\b(Code\s+(?:of\s+)?Civ\.\s*Proc\.,?\s*(?:§§?|sections?|secs?\.)\s*[\d.]+(?:\([a-z0-9]+\))*(?:\s*(?:-|--|–|—|through|to|and|,)\s*[\d.]+(?:\([a-z0-9]+\))*)*)")),
    ("statute", _re.compile(r"\b((?:CCP|Fam\s*C|Evid\s*C|Civ\s*C)\s*(?:§§?)\s*[\d.]+(?:\([a-z0-9]+\))*)")),
    ("rule", _re.compile(r"\b((?:Cal\.\s*Rules\s+of\s+Court|CRC|Cal\.\s*R\.\s*Ct\.),?\s*(?:rules?|r\.)?\s*\d+\.\d+(?:\([a-z0-9]+\))*(?:\s*(?:-|--|–|—|through|to|and|,)\s*\d+\.\d+(?:\([a-z0-9]+\))*)*)", _re.I)),
    ("rule", _re.compile(r"\b((?:Local\s+Rules?|LR|Sonoma\s+County\s+Local\s+Rules?),?\s*(?:rule\s*)?\d+(?:\.\d+)*[A-Z]?(?:\([a-z0-9]+\))*)")),
    ("federal", _re.compile(r"\b(\d+\s+(?:U\.S\.C\.|C\.F\.R\.)\s*(?:§§?|sections?)\s*[\d.]+[a-z]?(?:-\d+[a-z]?)?(?:\([a-z0-9]+\))*(?:\s*(?:--|–|—|through|to|and|,)\s*[\d.]+[a-z]?(?:-\d+)?(?:\([a-z0-9]+\))*)*)")),
    ("case", _re.compile(r"((?:In\s+re\s+(?:Marriage\s+of\s+)?)?[A-Z][A-Za-z.'&\- ]{1,60}?\s+v\.\s+[A-Z][A-Za-z.'&\- ]{1,60}?\s*\((?:19|20)\d{2}\)\s*\d+\s+(?:Cal\.\s*(?:App\.\s*)?(?:\dth|\dd|Supp\.)?|Cal\.\s*Rptr\.\s*\dd|U\.S\.|S\.\s*Ct\.|F\.\s*(?:\dd|Supp\.\s*\dd)|L\.\s*Ed\.\s*\dd)\s*\d+(?:,\s*\d+(?:-\d+)?)?)")),
    ("case", _re.compile(r"((?:In\s+re\s+(?:Marriage\s+of\s+)?)[A-Z][A-Za-z.'&\- ]{1,60}?\s*\((?:19|20)\d{2}\)\s*\d+\s+Cal\.\s*(?:App\.\s*)?(?:\dth|\dd)\s*\d+(?:,\s*\d+)?)")),
]


def _cite_key(kind: str, text: str) -> str:
    t = _re.sub(r"\s+", " ", text.strip())
    t = t.replace("§§", "§").replace("sections", "§").replace("section", "§").replace("secs.", "§").replace("sec.", "§")
    return f"{kind}:{t.lower()}"


def envelope_sources(matter: Path, target: str) -> list[Path]:
    """Source files for an envelope name, or a single source path."""
    import yaml
    cand = (matter / target)
    if cand.is_file():
        return [cand]
    env_file = matter / "envelopes.yaml"
    envs = (yaml.safe_load(env_file.read_text()) or {}).get("envelopes") or {} if env_file.is_file() else {}
    spec = envs.get(target)
    if spec is None:
        raise SystemExit(f"sc review: {target!r} is neither an envelope in envelopes.yaml nor a source file")
    out: list[Path] = []
    for item in spec.get("sources") or []:
        f = item.get("file") if isinstance(item, dict) else item
        if f:
            out.append(matter / "src" / f)
    return out


def source_hash(paths: list[Path]) -> tuple[str, dict[str, str]]:
    """Combined and per-file sha256 of the sources under review."""
    per: dict[str, str] = {}
    h = hashlib.sha256()
    for p in sorted(paths):
        d = hashlib.sha256(p.read_bytes()).hexdigest() if p.exists() else "missing"
        per[str(p)] = d
        h.update(f"{p}:{d}\n".encode())
    return h.hexdigest(), per


def extract_cites(paths: list[Path], matter: Path) -> list[dict]:
    rows: list[dict] = []
    seen: set[tuple[str, str, int]] = set()
    for p in paths:
        if not p.exists():
            continue
        for lno, line in enumerate(p.read_text(encoding="utf-8", errors="replace").splitlines(), 1):
            if line.lstrip().startswith(("#", "<!--")):
                pass
            for kind, rx in CITE_PATTERNS:
                for m in rx.finditer(line):
                    text = m.group(1).strip().rstrip(".,;")
                    key = (kind, _cite_key(kind, text), lno)
                    if key in seen:
                        continue
                    seen.add(key)
                    rows.append({"kind": kind, "cite": text, "file": str(p.relative_to(matter)), "line": lno,
                                 "key": _cite_key(kind, text)})
    return rows


def load_authorities(matter: Path) -> dict:
    """knowledge/authorities.yaml: cites a human has verified, with notes.
    Keys are normalized cite strings; a value carries status (verified |
    bad | superseded), a proposition, a checked date and a source."""
    import yaml
    p = matter / "knowledge" / "authorities.yaml"
    if not p.is_file():
        return {}
    data = yaml.safe_load(p.read_text()) or {}
    out = {}
    for k, v in (data.get("authorities") or {}).items():
        out[_re.sub(r"\s+", " ", str(k)).strip().lower()] = v or {}
    return out


def review_dir(matter: Path, target: str) -> Path:
    name = _re.sub(r"[^A-Za-z0-9_.-]+", "-", target.replace("src/", "")).strip("-")
    d = matter / "derived" / "review" / name
    d.mkdir(parents=True, exist_ok=True)
    return d


def report_path(matter: Path, target: str, check: str, short_hash: str) -> Path:
    import datetime as dt
    return review_dir(matter, target) / f"{dt.date.today().isoformat()}_{check}_{short_hash}.md"


def report_header(target: str, check: str, combined: str, per: dict[str, str], matter: Path) -> str:
    import datetime as dt
    lines = ["---", f"check: {check}", f"target: {target}", f"reviewed: {dt.datetime.now().isoformat(timespec='seconds')}",
             f"source_hash: {combined}", "sources:"]
    for p, h in per.items():
        try:
            rel = str(Path(p).relative_to(matter))
        except ValueError:
            rel = p
        lines.append(f"  - path: {rel}")
        lines.append(f"    sha256: {h}")
    head = _git_lines(matter, "rev-parse", "--short", "HEAD")
    if head:
        lines.append(f"commit: {head[0]}")
    lines.append("status: current   # `sc review status` rewrites this to stale when a source changes")
    lines.append("---")
    return "\n".join(lines) + "\n"


def review_status(matter: Path, target: str | None = None, tidy: bool = False) -> list[dict]:
    """Every report under derived/review/ compared with its sources now.
    A report whose recorded source_hash differs from the sources' current
    hash is stale: it critiqued a superseded revision. --tidy moves stale
    reports into superseded/ so nothing quotes them by accident."""
    root = matter / "derived" / "review"
    rows: list[dict] = []
    if not root.is_dir():
        return rows
    dirs = [review_dir(matter, target)] if target else [d for d in root.iterdir() if d.is_dir()]
    for d in dirs:
        for rp in sorted(d.glob("*.md")):
            meta, _, err = _split_fm(rp.read_text(encoding="utf-8", errors="replace"))
            if err or "source_hash" not in meta:
                rows.append({"report": str(rp.relative_to(matter)), "state": "unknown", "why": err or "no source_hash"})
                continue
            srcs = [matter / str(x.get("path")) for x in (meta.get("sources") or []) if isinstance(x, dict)]
            now, _ = source_hash(srcs)
            state = "current" if now == meta["source_hash"] else "stale"
            row = {"report": str(rp.relative_to(matter)), "state": state, "check": meta.get("check"),
                   "target": meta.get("target"), "reviewed": meta.get("reviewed")}
            if state == "stale":
                changed = [str(x.get("path")) for x in (meta.get("sources") or [])
                           if isinstance(x, dict) and (not (matter / str(x.get("path"))).exists()
                           or hashlib.sha256((matter / str(x.get("path"))).read_bytes()).hexdigest() != x.get("sha256"))]
                row["why"] = "changed since review: " + ", ".join(changed)
                text = rp.read_text(encoding="utf-8", errors="replace")
                if "status: current" in text:
                    rp.write_text(text.replace("status: current   # `sc review status` rewrites this to stale when a source changes",
                                               "status: stale   # sources changed after this review; do not quote as current", 1), encoding="utf-8")
                if tidy:
                    sup = rp.parent / "superseded"
                    sup.mkdir(exist_ok=True)
                    rp.rename(sup / rp.name)
                    row["moved"] = str((sup / rp.name).relative_to(matter))
            rows.append(row)
    return rows


def _split_fm(text: str):
    if not text.startswith("---\n"):
        return {}, text, "no front matter"
    end = text.find("\n---", 4)
    if end == -1:
        return {}, text, "unterminated front matter"
    import yaml
    try:
        meta = yaml.safe_load(text[4:end]) or {}
    except yaml.YAMLError as exc:
        return {}, text, f"bad front matter: {exc}"
    return meta, text[end + 4:], None


def _second_opinion(matter: Path, target: str, srcs: list[Path], combined: str, per: dict, brief: str) -> int:
    """Ask a different model (the `second-opinion` role, usually another
    vendor) for numbered suggestions on a draft, given a one-paragraph
    brief of what the draft must achieve. Writes the raw suggestions as a
    report; the /secondopinion skill then has the drafting model weigh
    each one against the sources and the record."""
    import yaml
    cfg = yaml.safe_load((matter / "matter.yaml").read_text()) or {}
    role = ((cfg.get("agent") or {}).get("roles") or {}).get("second-opinion") or {}
    if not role.get("cmd") and not os.environ.get("PROSAIC_AGENT_CMD"):
        print("sc review second-opinion: no command configured. In matter.yaml set\n"
              "  agent:\n    roles:\n      second-opinion:\n"
              "        cmd: <prosaic>/sync/second_opinion_openai.sh\n"
              "        credential: prosaic.openai      # Keychain item holding the API key\n"
              "        model: gpt-5\n"
              "(any command that reads a prompt on stdin and prints text works).", file=sys.stderr)
        return 2
    template = (ROOT / "triage" / "prompts" / "second_opinion.md").read_text(encoding="utf-8")
    body = []
    for p in srcs:
        if p.exists():
            body.append(f"\n===== {p.relative_to(matter)} =====\n" + p.read_text(encoding="utf-8", errors="replace"))
    prompt = template.replace("{brief}", brief or "(no brief given)").replace("{draft}", "\n".join(body))
    agent_run = ROOT / "cli" / "agent-run"
    proc = subprocess.run([str(agent_run), "--role", "second-opinion"], input=prompt, text=True,
                          cwd=matter, capture_output=True)
    if proc.returncode != 0:
        print(f"second-opinion command failed ({proc.returncode}): {proc.stderr[-800:]}", file=sys.stderr)
        return 1
    rp = report_path(matter, target, "secondopinion", combined[:7])
    header = report_header(target, "secondopinion", combined, per, matter)
    model = role.get("model") or "(configured command)"
    cost_line = record_external_cost(matter, role, proc.stderr, purpose=f"second-opinion {target}")
    rp.write_text(header + f"\n# Second opinion on {target}\n\nmodel: {model}\nbrief: {brief}\n{cost_line}\n\n"
                  + proc.stdout.strip() + "\n", encoding="utf-8")
    print(rp)
    print(cost_line)
    return 0


def record_external_cost(matter: Path, role: dict, stderr: str, purpose: str) -> str:
    """Price one call to an outside model from the @@USAGE line its command
    emitted, using the role's price_per_million (input/output, USD). The
    line is returned for the report and appended to
    .state/external_model_calls.jsonl, which the brief sums for the month.
    Without a price the tokens are still reported and the cost is marked
    unknown, so a missing number is visible rather than a silent zero."""
    import datetime as dt
    usage = None
    for ln in stderr.splitlines():
        if ln.startswith("@@USAGE "):
            try:
                usage = json.loads(ln[len("@@USAGE "):])
            except json.JSONDecodeError:
                usage = None
    if not usage:
        return "cost: unknown (the command reported no token usage)"
    price = role.get("price_per_million") or {}
    pin, pout = price.get("input"), price.get("output")
    i, o = int(usage.get("input_tokens", 0)), int(usage.get("output_tokens", 0))
    if pin is not None and pout is not None:
        usd = i * float(pin) / 1e6 + o * float(pout) / 1e6
        cost = f"${usd:.4f}"
    else:
        usd = None
        cost = "unknown (set agent.roles.<role>.price_per_million: {input: X, output: Y} in matter.yaml)"
    line = (f"cost: {cost} --- {usage.get('model')}: {i:,} input + {o:,} output tokens"
            + (f" @ ${pin}/${pout} per million" if usd is not None else ""))
    ledger = matter / ".state" / "external_model_calls.jsonl"
    ledger.parent.mkdir(parents=True, exist_ok=True)
    with ledger.open("a", encoding="utf-8") as fh:
        fh.write(json.dumps({"when": dt.datetime.now().isoformat(timespec="seconds"), "purpose": purpose,
                             "model": usage.get("model"), "input_tokens": i, "output_tokens": o,
                             "usd": usd}) + "\n")
    return line


def external_spend_line(matter: Path) -> str | None:
    """Month-to-date spend on outside models, for the brief and the agenda."""
    import datetime as dt
    ledger = matter / ".state" / "external_model_calls.jsonl"
    if not ledger.is_file():
        return None
    month = dt.date.today().strftime("%Y-%m")
    n = 0; usd = 0.0; unknown = 0
    for ln in ledger.read_text(encoding="utf-8").splitlines():
        try:
            rec = json.loads(ln)
        except json.JSONDecodeError:
            continue
        if not str(rec.get("when", "")).startswith(month):
            continue
        n += 1
        if rec.get("usd") is None:
            unknown += 1
        else:
            usd += float(rec["usd"])
    if not n:
        return None
    s = f"outside-model calls this month: {n}, ${usd:.2f}"
    if unknown:
        s += f" ({unknown} unpriced)"
    return s


def cmd_review(args: argparse.Namespace) -> int:
    matter = _matter_root(Path(args.matter_dir))
    if args.action == "status":
        rows = review_status(matter, args.target, tidy=args.tidy)
        if not rows:
            print("no review reports")
            return 0
        for r in rows:
            extra = f" --- {r['why']}" if r.get("why") else ""
            moved = f" -> {r['moved']}" if r.get("moved") else ""
            print(f"{r['state']:<8} {r['report']}{extra}{moved}")
        stale = sum(1 for r in rows if r["state"] == "stale")
        print(f"{len(rows)} report(s), {stale} stale" + (" (moved to superseded/)" if args.tidy and stale else ""))
        return 0
    if not args.target:
        print("sc review <paths|cites|report|status> <envelope|source> [--check NAME]", file=sys.stderr)
        return 2
    srcs = envelope_sources(matter, args.target)
    combined, per = source_hash(srcs)
    if args.action == "paths":
        print(f"# review target: {args.target}")
        print(f"source_hash: {combined}")
        print("## sources")
        for p in srcs:
            print(f"- {p.relative_to(matter)}" + ("" if p.exists() else "  (MISSING)"))
        out = matter / "out" / args.target
        if out.is_dir():
            print("## built outputs")
            for p in sorted(out.rglob("*")):
                if p.is_file() and not p.name.startswith(".") and p.suffix in (".pdf", ".docx", ".json", ".txt"):
                    print(f"- {p.relative_to(matter)}")
        prof = matter / "knowledge" / "topics" / "opposing-counsel-profile.md"
        print("## opposing-counsel profile")
        print(f"- {prof.relative_to(matter)}" if prof.exists() else "- none yet (knowledge/topics/opposing-counsel-profile.md; the refinement loop proposes it)")
        prior = [r for r in review_status(matter, args.target) if r["state"] == "current"]
        print(f"## current reports for this target: {len(prior)}")
        for r in prior:
            print(f"- {r['report']} ({r.get('check')})")
        stale = [r for r in review_status(matter, args.target) if r["state"] == "stale"]
        if stale:
            print(f"## STALE reports (sources changed since; do not quote): {len(stale)}")
            for r in stale:
                print(f"- {r['report']}")
        return 0
    if args.action == "cites":
        rows = extract_cites(srcs, matter)
        auth = load_authorities(matter)
        print(f"# citations in {args.target}: {len(rows)} (source_hash {combined[:12]})")
        print("| # | kind | cite | where | authority cache |")
        print("|---|---|---|---|---|")
        for i, r in enumerate(rows, 1):
            a = auth.get(r["key"].split(":", 1)[1])
            status = (a.get("status", "verified") if a else "unverified")
            note = f" ({a.get('proposition', '')[:60]})" if a and a.get("proposition") else ""
            print(f"| {i} | {r['kind']} | {r['cite']} | {r['file']}:{r['line']} | {status}{note} |")
        if not rows:
            print("(no citations recognized; if the draft has cites, the extractor needs a pattern for them)")
        return 0
    if args.action == "second-opinion":
        return _second_opinion(matter, args.target, srcs, combined, per, args.brief or "")
    if args.action == "report":
        check = args.check or "review"
        rp = report_path(matter, args.target, check, combined[:7])
        if not rp.exists():
            rp.write_text(report_header(args.target, check, combined, per, matter), encoding="utf-8")
        print(rp)
        return 0
    return 2


# ---------------------------------------------------------------------------
# refine and standup: the nightly proposal and the morning agenda (ADR-0044)
# ---------------------------------------------------------------------------

def _git_since(matter: Path, since: str, fmt: str = "%h %ad %s", n: int = 60) -> list[str]:
    return _git_lines(matter, "log", f"--since={since}", f"--format={fmt}", "--date=short", f"-{n}")


def _last_run(matter: Path) -> dict:
    p = matter / ".state" / "sync_last_run.json"
    if not p.is_file():
        return {}
    try:
        return json.loads(p.read_text())
    except json.JSONDecodeError:
        return {}


def refine_inputs(matter: Path, since_days: int = 1) -> str:
    """Everything the refinement agent may read, gathered deterministically
    so the agent starts from facts rather than from a scan of the tree."""
    import datetime as dt
    since = (dt.date.today() - dt.timedelta(days=since_days)).isoformat()
    parts = [f"# refine inputs for {matter.name}, changes since {since}", ""]
    parts.append("## Commits")
    parts += [f"- {ln}" for ln in _git_since(matter, since)] or ["- none"]
    parts.append("")
    parts.append("## Files changed")
    changed = _git_lines(matter, "log", f"--since={since}", "--name-only", "--format=")
    seen: list[str] = []
    for c in changed:
        if c not in seen:
            seen.append(c)
    parts += [f"- {c}" for c in seen[:200]] or ["- none"]
    parts.append("")
    if (matter / "knowledge").is_dir():
        kv = _knowledge()
        notes = kv.check(matter)
        errs = [f"{n.path.name}: {p}" for n in notes for p in n.problems]
        parts.append(f"## Knowledge vault: {len(notes)} notes, {len(errs)} lint errors, "
                     f"{sum(1 for n in notes if n.staging)} staging")
        parts += [f"- ERROR {e}" for e in errs[:40]]
        # notes touched by the changed documents: any note whose sources name a changed path
        touched = []
        for n in notes:
            for src in (n.meta.get("sources") or []):
                if isinstance(src, dict) and str(src.get("path")) in seen:
                    touched.append(f"[[{n.stem}]] cites changed {src.get('path')}")
        parts += [f"- {t}" for t in touched[:60]]
        stale = [n for n in notes if not n.staging and str(n.meta.get("updated", "")) < (dt.date.today() - dt.timedelta(days=30)).isoformat()]
        parts.append(f"- {len(stale)} note(s) not updated in 30 days" + (": " + ", ".join(f"[[{n.stem}]]" for n in stale[:20]) if stale else ""))
        parts.append("")
    tc = _text_coverage()
    docs = tc.audit(matter)
    parts.append("## Text coverage")
    parts.append("- " + tc.coverage_line(docs))
    parts += [f"- [{d.state}] {d.path}" for d in docs if not d.searched and d.state != "untriaged"][:20]
    parts.append("")
    run = _last_run(matter)
    if run:
        parts.append("## Last sync")
        parts.append(f"- {run.get('mode')} run, outcome {run.get('outcome')}, {run.get('new_files', 0)} new file(s), triage {run.get('triage')}"
                     + (f", failed connectors: {', '.join(run['failed_connectors'])}" if run.get("failed_connectors") else ""))
        parts.append("")
    q = _list_items(matter / "QUESTIONS.md", 50)
    parts.append(f"## QUESTIONS.md ({len(q)} open)")
    parts += [f"- {x[:200]}" for x in q]
    parts.append("")
    todo = _list_items(matter / "TODO.md", 12)
    parts.append("## TODO.md (top)")
    parts += [f"- {x[:200]}" for x in todo]
    return "\n".join(parts) + "\n"


def cmd_refine(args: argparse.Namespace) -> int:
    """Nightly: gather inputs deterministically, then one agent pass that
    writes proposals and questions to derived/refine/<date>.md and nothing
    else. Notes change only through the standup, with a human."""
    import datetime as dt
    matter = _matter_root(Path(args.matter_dir))
    out_dir = matter / "derived" / "refine"
    out_dir.mkdir(parents=True, exist_ok=True)
    today = dt.date.today().isoformat()
    inputs = out_dir / f"{today}_inputs.md"
    proposal = out_dir / f"{today}.md"
    inputs.write_text(refine_inputs(matter, since_days=args.since_days), encoding="utf-8")
    print(f"wrote {inputs.relative_to(matter)}")
    if args.inputs_only:
        return 0
    if args.scheduled and proposal.exists():
        print(f"{proposal.relative_to(matter)} exists; not rerunning")
        return 0
    agent_run = ROOT / "cli" / "agent-run"
    if subprocess.run([str(agent_run), "--check"], capture_output=True).returncode != 0:
        print("no agent CLI available; inputs written, no proposal", file=sys.stderr)
        return 1
    template = (ROOT / "triage" / "prompts" / "refine.md").read_text(encoding="utf-8")
    prompt = template.replace("{inputs}", str(inputs.relative_to(matter))).replace(
        "{proposal}", str(proposal.relative_to(matter))).replace("{date}", today)
    before = set(_git_lines(matter, "status", "--porcelain"))
    proc = subprocess.run([str(agent_run), "--yolo", "--role", "refine"], input=prompt, text=True,
                          cwd=matter, capture_output=True)
    after = set(_git_lines(matter, "status", "--porcelain"))
    strays = sorted(x for x in after - before if "derived/refine" not in x)
    if strays:
        print("WARNING: refine touched files outside derived/refine (left in place, review them):", file=sys.stderr)
        for x in strays:
            print(f"  {x}", file=sys.stderr)
    if proc.returncode != 0:
        print(f"refine agent failed ({proc.returncode}): {proc.stderr[-500:]}", file=sys.stderr)
        return 1
    if not proposal.exists():
        proposal.write_text(f"# refine {today}\n\n(the agent produced no proposal file; its output follows)\n\n{proc.stdout}", encoding="utf-8")
    print(f"wrote {proposal.relative_to(matter)}")
    return 0


def standup_agenda(matter: Path) -> str:
    import datetime as dt
    today = dt.date.today().isoformat()
    lines = [f"# Standup agenda: {matter.name}, {today}", ""]
    lines.append(render_brief(matter, todo_limit=6, dates_limit=8).split("\n", 1)[1])
    run = _last_run(matter)
    lines.append("## Sync")
    if run:
        fin = dt.datetime.fromtimestamp(run.get("finished", 0)).strftime("%Y-%m-%d %H:%M")
        lines.append(f"- last {run.get('mode')} run {fin}: outcome {run.get('outcome')}, "
                     f"{run.get('new_files', 0)} new file(s), triage {run.get('triage')}")
        if run.get("failed_connectors"):
            lines.append(f"- FAILED connectors: {', '.join(run['failed_connectors'])}")
    else:
        lines.append("- no run recorded yet")
    lines.append("")
    refine_dir = matter / "derived" / "refine"
    props = sorted(refine_dir.glob("????-??-??.md")) if refine_dir.is_dir() else []
    lines.append("## Refinement proposals")
    if props:
        latest = props[-1]
        lines.append(f"- latest: `{latest.relative_to(matter)}` ({sum(1 for _ in latest.open())} lines); "
                     "accept, amend or reject each item during standup")
    else:
        lines.append("- none yet (`sc refine .` produces one)")
    lines.append("")
    q = _list_items(matter / "QUESTIONS.md", 40)
    lines.append(f"## Open questions ({len(q)})")
    lines += [f"- {x[:220]}" for x in q] or ["- none"]
    lines.append("")
    if (matter / "knowledge").is_dir():
        kv = _knowledge()
        notes = kv.check(matter)
        staging = sum(1 for n in notes if n.staging)
        errs = sum(len(n.problems) for n in notes)
        unsourced = [n for n in notes if not n.staging and not (n.meta.get("sources") or [])]
        lines.append("## Knowledge vault")
        lines.append(f"- {len(notes)} notes, {errs} lint error(s), {staging} in migration staging, "
                     f"{len(unsourced)} note(s) without sources")
        lines.append("")
    lines.append("## How to run this standup")
    lines.append("Open the matter in a session and run `/standup`. Thirty minutes: answer questions, "
                 "decide proposals, correct notes. Answers land in the vault as `verified: human`; "
                 "resolved questions leave QUESTIONS.md; the session ends with `record(standup)`.")
    return "\n".join(lines) + "\n"


def cmd_standup(args: argparse.Namespace) -> int:
    import datetime as dt
    matter = _matter_root(Path(args.matter_dir))
    if args.action != "agenda":
        return 2
    out_dir = matter / "derived" / "standup"
    out_dir.mkdir(parents=True, exist_ok=True)
    p = out_dir / f"{dt.date.today().isoformat()}.md"
    p.write_text(standup_agenda(matter), encoding="utf-8")
    print(p)
    if args.notify and _platform().startswith(("darwin", "Darwin")):
        msg = f"Standup agenda ready for {matter.name}: run /standup"
        subprocess.run(["osascript", "-e", f'display notification "{msg}" with title "prosaic"'],
                       capture_output=True)
    return 0


# ---------------------------------------------------------------------------
# Session brief and open: the deterministic paths behind the routine
# harness commands (ADR-0040). Neither asks a model anything.
# ---------------------------------------------------------------------------

def _matter_root(start: Path) -> Path:
    """Walk up from `start` to the directory holding matter.yaml."""
    here = start.expanduser().resolve()
    for cand in (here, *here.parents):
        if (cand / "matter.yaml").is_file():
            return cand
    raise SystemExit(f"no matter.yaml at or above {start}")


def _git_lines(matter: Path, *argv: str) -> list[str]:
    if not (matter / ".git").exists():
        return []
    proc = subprocess.run(["git", *argv], cwd=matter, capture_output=True, text=True)
    return [ln for ln in proc.stdout.splitlines() if ln.strip()] if proc.returncode == 0 else []


def _list_items(path: Path, limit: int) -> list[str]:
    """First `limit` list items of a Markdown live list (TODO/QUESTIONS)."""
    if not path.is_file():
        return []
    import re
    items: list[str] = []
    for ln in path.read_text(errors="replace").splitlines():
        st = ln.strip()
        if re.match(r"^(?:[-*]|\d+[.)])\s+\S", st):
            items.append(st)
            if len(items) >= limit:
                break
    return items


def _count_items(path: Path) -> int:
    return len(_list_items(path, 10_000))


def _knowledge_dates(path: Path, limit: int) -> list[str]:
    """Lines under any heading that reads like a calendar: hearings, key
    dates, deadlines. Heading match is by name, not by position, so a
    matter whose KNOWLEDGE has drifted still yields something."""
    if not path.is_file():
        return []
    import re
    out: list[str] = []
    grab = False
    for ln in path.read_text(errors="replace").splitlines():
        if ln.startswith("#"):
            grab = bool(re.search(r"hearing|key dates|deadline|calendar|upcoming", ln, re.I))
            continue
        if grab and ln.strip():
            out.append(ln.rstrip())
            if len(out) >= limit:
                break
    return out


def _age(ts: float) -> str:
    import time
    delta = max(0, time.time() - ts)
    if delta < 3600:
        return f"{int(delta // 60)} min ago"
    if delta < 86400:
        return f"{delta / 3600:.0f} h ago"
    return f"{delta / 86400:.1f} d ago"


def render_brief(matter: Path, todo_limit: int = 8, dates_limit: int = 10) -> str:
    """A matter brief small enough to load into every session.

    The knowledge file of a live matter is tens of thousands of tokens
    and grows; loading it whole into every session is what made every
    call slow. The brief is the two-minute orientation instead: what
    the case is, what is next, what is open, what changed, where the
    routine commands are. Everything else is read on demand.
    """
    import datetime as dt
    import yaml
    cfg = yaml.safe_load((matter / "matter.yaml").read_text()) or {}
    case = cfg.get("case") or {}
    lines: list[str] = []
    name = case.get("name") or matter.name
    head = f"# Matter brief: {name}"
    bits = [b for b in (case.get("number"), case.get("court")) if b]
    if bits:
        head += " (" + ", ".join(str(b) for b in bits) + ")"
    lines.append(head)
    meta = [f"generated {dt.date.today().isoformat()}"]
    if case.get("role"):
        meta.append(f"our role: {case['role']}")
    if case.get("type"):
        meta.append(f"type: {case['type']}")
    lines.append("- " + "; ".join(meta))
    lines.append(f"- matter dir: `{matter}`; prosaic: `{ROOT}`")
    rel = (cfg.get("related_matters") or [])
    if rel:
        lines.append(f"- related matters searched by `/find`: {', '.join(str(r) for r in rel)}")

    env_file = matter / "envelopes.yaml"
    if env_file.is_file():
        envs = (yaml.safe_load(env_file.read_text()) or {}).get("envelopes") or {}
        if envs:
            lines.append("")
            lines.append(f"## Envelopes ({len(envs)})")
            lines.append(", ".join(f"`{e}`" for e in envs))

    dates: list[str] = []
    if (matter / "knowledge").is_dir():
        try:
            kv = _knowledge()
            dates = kv.upcoming_events(matter, dates_limit)
            issues = kv.open_issues(matter)
        except Exception:  # the brief must never fail on a vault error
            issues = []
        if dates:
            lines.append("")
            lines.append("## Upcoming events (knowledge vault)")
            lines.extend(f"- {d}" for d in dates)
        if issues:
            lines.append("")
            lines.append(f"## Open issues ({len(issues)})")
            lines.extend(f"- {i}" for i in issues)
    if not dates:
        dates = _knowledge_dates(matter / "KNOWLEDGE.md", dates_limit)
        if dates:
            lines.append("")
            lines.append("## Dates and hearings (from KNOWLEDGE.md)")
            lines.extend(dates)

    todo = _list_items(matter / "TODO.md", todo_limit)
    if todo:
        total = _count_items(matter / "TODO.md")
        lines.append("")
        lines.append(f"## Open TODO (top {len(todo)} of {total})")
        lines.extend(t[:160] for t in todo)
    q = _count_items(matter / "QUESTIONS.md")
    if q:
        lines.append(f"- QUESTIONS.md holds {q} open item(s)")

    docket = _git_lines(matter, "log", "-5", "--format=%ad %s", "--date=short",
                        "-E", "--grep", r"^docket")
    if docket:
        lines.append("")
        lines.append("## Recent docket events (git)")
        lines.extend(f"- {d[:140]}" for d in docket)
    last = _git_lines(matter, "log", "-3", "--format=%ad %s", "--date=short")
    if last:
        lines.append("")
        lines.append("## Last commits")
        lines.extend(f"- {d[:140]}" for d in last)

    lines.append("")
    lines.append("## State")
    guard = matter / ".state" / "sync_last_success"
    if guard.is_file():
        lines.append(f"- last successful sync: {_age(guard.stat().st_mtime)}")
    run = _last_run(matter)
    if run:
        bad = run.get("failed_connectors") or []
        lines.append(f"- last {run.get('mode')} run: {run.get('outcome')}, {run.get('new_files', 0)} new, "
                     f"triage {run.get('triage')}" + (f"; FAILED connectors: {', '.join(bad)}" if bad else ""))
    rdir = matter / "derived" / "refine"
    if rdir.is_dir():
        props = sorted(rdir.glob("????-??-??.md"))
        if props:
            lines.append(f"- refinement proposal pending: `{props[-1].relative_to(matter)}` (decide it in `/standup`)")
    conns = list((cfg.get("connectors") or {}).keys())
    if conns:
        lines.append(f"- connectors: {', '.join(conns)}")
    inbox = matter / "inbox"
    if inbox.is_dir():
        n_inbox = sum(1 for f in inbox.rglob("*") if f.is_file() and not f.name.startswith("."))
        lines.append(f"- inbox/: {n_inbox} untriaged file(s)")
    dirty = _git_lines(matter, "status", "--short")
    if (matter / ".git").exists():
        lines.append(f"- working tree: {len(dirty)} changed path(s)")
    spend = external_spend_line(matter)
    if spend:
        lines.append(f"- {spend}")
    know = matter / "KNOWLEDGE.md"
    if know.is_file():
        n = sum(1 for _ in know.open(errors="replace"))
        lines.append(f"- KNOWLEDGE.md: {n} lines; read the section you need, not the file")
    try:
        tc = _text_coverage()
        lines.append("- " + tc.coverage_line(tc.audit(matter)))
    except Exception as exc:  # the brief must never fail on a coverage error
        lines.append(f"- text coverage: audit failed ({type(exc).__name__})")

    lines.append("")
    lines.append("## Routine commands (deterministic; no deliberation needed)")
    lines.append("`/build <envelope>` `/build-doc <src>` `/open <envelope>` `/clean` "
                 "`/status` `/find <term>` `/commit <type(scope): subject>` --- each runs the CLI and "
                 "reports; a warning that needs a source edit is a separate, visible decision.")
    return "\n".join(lines) + "\n"


