# knowledge: the vault of notes (ADR-0043)
# ---------------------------------------------------------------------------

def _knowledge():
    sys.path.insert(0, str(ROOT / "triage"))
    import knowledge_vault  # noqa: E402
    return knowledge_vault


def cmd_knowledge(args: argparse.Namespace) -> int:
    kv = _knowledge()
    matter = _matter_root(Path(args.matter_dir))
    if args.action == "init":
        print("\n".join(kv.init(matter, migrate=args.migrate)))
        return 0
    if args.action == "new":
        if not args.type or not args.title:
            print("sc knowledge new <matter> --type T --title 'X' [--alias A]...", file=sys.stderr)
            return 2
        p = kv.new_note(matter, args.type, args.title, args.alias)
        kv.write_index(matter, kv.load_notes(matter))
        print(p)
        return 0
    if args.action == "index":
        print(kv.write_index(matter, kv.load_notes(matter)))
        return 0
    if args.action == "migrate":
        out = kv.migrate_legacy(matter)
        kv.write_index(matter, kv.load_notes(matter))
        print("\n".join(out))
        return 0
    if args.action == "check":
        if args.fix:
            kv.write_index(matter, kv.load_notes(matter))
        notes = kv.check(matter)
        sys.stdout.write(kv.format_check(notes))
        return 1 if any(n.problems for n in notes) else 0
    return 2


# ---------------------------------------------------------------------------
# upgrade: bring an existing matter onto the current conventions
# ---------------------------------------------------------------------------

def cmd_upgrade(args: argparse.Namespace) -> int:
    """Every deterministic migration prosaic knows, in order, idempotent,
    followed by the list of what still needs a human or an agent. The
    canonical target is a live matter that predates all of it: the
    harness bundle (ADR-0040), the derived text tree (ADR-0041/0042) and
    the knowledge vault (ADR-0043) each install here.
    """
    matter = _matter_root(Path(args.matter_dir))
    dry = args.dry_run
    todo: list[str] = []
    print(f"== upgrade {matter}{' (dry run)' if dry else ''}")

    print("-- harness bundle (ADR-0040)")
    if dry:
        print("   would install/refresh .claude/settings.json and the seven routine commands")
    else:
        cmd_harness(argparse.Namespace(matter_dir=str(matter)))

    print("-- derived text tree (ADR-0041, ADR-0042)")
    tc = _text_coverage()
    moves = tc.migrate(matter, dry_run=dry)
    print(f"   migrate: {len(moves)} action(s)" + ("" if moves else " (nothing beside originals)"))
    docs = tc.ensure(matter, dry_run=dry, jobs=args.jobs) if not dry else tc.audit(matter)
    print("   " + tc.coverage_line(docs))
    gaps = [d for d in docs if not d.searched and d.state != "untriaged"]
    if gaps:
        todo.append(f"{len(gaps)} document(s) still not searchable: `sc text audit .` names them "
                    "(photo pages need a human description; audio needs the local STT pipeline)")

    print("-- knowledge vault (ADR-0043)")
    kv = _knowledge()
    legacy = matter / "KNOWLEDGE.md"
    if (matter / kv.VAULT).is_dir() and legacy.exists() and kv.INDEX_START in legacy.read_text(errors="replace"):
        notes = kv.check(matter)
        staging = [n for n in notes if n.staging]
        errs = sum(len(n.problems) for n in notes)
        print(f"   vault present: {len(notes)} note(s), {errs} lint error(s), {len(staging)} in staging")
        if staging:
            todo.append(f"{len(staging)} staging note(s) under knowledge/_migration: run the "
                        "migrate-knowledge skill, then `sc knowledge check`")
        if errs:
            todo.append("`sc knowledge check` reports errors; fix the notes")
    elif legacy.exists():
        n_lines = sum(1 for _ in legacy.open(errors="replace"))
        if dry:
            print(f"   would split the {n_lines}-line KNOWLEDGE.md into staging notes and make it the index")
        else:
            for line in kv.init(matter, migrate=True):
                print("   " + line)
        todo.append("run the migrate-knowledge skill over knowledge/_migration (agent, Fable, gated by you)")
    else:
        if dry:
            print("   would scaffold knowledge/")
        else:
            for line in kv.init(matter):
                print("   " + line)

    print("-- .gitignore")
    gi = matter / ".gitignore"
    have = gi.read_text().splitlines() if gi.exists() else []
    want = ["derived/ocr/", ".obsidian/", ".state/"]
    missing = [w for w in want if w not in have]
    if missing and not dry:
        gi.write_text((gi.read_text().rstrip("\n") + "\n" if gi.exists() else "") + "\n".join(missing) + "\n")
    print(f"   {'would add' if dry else 'added'} {missing}" if missing else "   complete")

    print("-- scheduled sync")
    label_old = Path.home() / "Library/LaunchAgents" / f"com.slopcannon.sync.{matter.name}.plist"
    label_new = Path.home() / "Library/LaunchAgents" / f"com.prosaic.sync.{matter.name}.plist"
    if label_old.exists() or label_new.exists():
        print(f"   installed ({'legacy label' if label_old.exists() else 'current label'}); "
              "matter_sync.sh is read from the checkout at run time, so no reinstall is needed")
    else:
        todo.append("no scheduled sync for this matter: `sc schedule .` installs one")

    print()
    if todo:
        print("Needs a human or an agent:")
        for t in todo:
            print(f"  - {t}")
    else:
        print("Nothing left that a tool can do; the matter is on current conventions.")
    return 0


# ---------------------------------------------------------------------------
# Session brief and open: the deterministic paths behind the routine
# harness commands (ADR-0040). Neither asks a model anything.
# ---------------------------------------------------------------------------

def _matter_root(start: Path) -> Path:
    """Walk up from `start` to the directory holding matter.yaml."""
    here = start.expanduser().resolve()
    for cand in (here, *here.parents):
        if (cand / "matter.yaml").is_file():
            return cand
    raise SystemExit(f"no matter.yaml at or above {start}")


def _git_lines(matter: Path, *argv: str) -> list[str]:
    if not (matter / ".git").exists():
        return []
    proc = subprocess.run(["git", *argv], cwd=matter, capture_output=True, text=True)
    return [ln for ln in proc.stdout.splitlines() if ln.strip()] if proc.returncode == 0 else []


def _list_items(path: Path, limit: int) -> list[str]:
    """First `limit` list items of a Markdown live list (TODO/QUESTIONS)."""
    if not path.is_file():
        return []
    import re
    items: list[str] = []
    for ln in path.read_text(errors="replace").splitlines():
        st = ln.strip()
        if re.match(r"^(?:[-*]|\d+[.)])\s+\S", st):
            items.append(st)
            if len(items) >= limit:
                break
    return items


def _count_items(path: Path) -> int:
    return len(_list_items(path, 10_000))


def _knowledge_dates(path: Path, limit: int) -> list[str]:
    """Lines under any heading that reads like a calendar: hearings, key
    dates, deadlines. Heading match is by name, not by position, so a
    matter whose KNOWLEDGE has drifted still yields something."""
    if not path.is_file():
        return []
    import re
    out: list[str] = []
    grab = False
    for ln in path.read_text(errors="replace").splitlines():
        if ln.startswith("#"):
            grab = bool(re.search(r"hearing|key dates|deadline|calendar|upcoming", ln, re.I))
            continue
        if grab and ln.strip():
            out.append(ln.rstrip())
            if len(out) >= limit:
                break
    return out


def _age(ts: float) -> str:
    import time
    delta = max(0, time.time() - ts)
    if delta < 3600:
        return f"{int(delta // 60)} min ago"
    if delta < 86400:
        return f"{delta / 3600:.0f} h ago"
    return f"{delta / 86400:.1f} d ago"


def render_brief(matter: Path, todo_limit: int = 8, dates_limit: int = 10) -> str:
    """A matter brief small enough to load into every session.

    The knowledge file of a live matter is tens of thousands of tokens
    and grows; loading it whole into every session is what made every
    call slow. The brief is the two-minute orientation instead: what
    the case is, what is next, what is open, what changed, where the
    routine commands are. Everything else is read on demand.
    """
    import datetime as dt
    import yaml
    cfg = yaml.safe_load((matter / "matter.yaml").read_text()) or {}
    case = cfg.get("case") or {}
    lines: list[str] = []
    name = case.get("name") or matter.name
    head = f"# Matter brief: {name}"
    bits = [b for b in (case.get("number"), case.get("court")) if b]
    if bits:
        head += " (" + ", ".join(str(b) for b in bits) + ")"
    lines.append(head)
    meta = [f"generated {dt.date.today().isoformat()}"]
    if case.get("role"):
        meta.append(f"our role: {case['role']}")
    if case.get("type"):
        meta.append(f"type: {case['type']}")
    lines.append("- " + "; ".join(meta))
    lines.append(f"- matter dir: `{matter}`; prosaic: `{ROOT}`")
    rel = (cfg.get("related_matters") or [])
    if rel:
        lines.append(f"- related matters searched by `/find`: {', '.join(str(r) for r in rel)}")

    env_file = matter / "envelopes.yaml"
    if env_file.is_file():
        envs = (yaml.safe_load(env_file.read_text()) or {}).get("envelopes") or {}
        if envs:
            lines.append("")
            lines.append(f"## Envelopes ({len(envs)})")
            lines.append(", ".join(f"`{e}`" for e in envs))

    dates: list[str] = []
    if (matter / "knowledge").is_dir():
        try:
            kv = _knowledge()
            dates = kv.upcoming_events(matter, dates_limit)
            issues = kv.open_issues(matter)
        except Exception:  # the brief must never fail on a vault error
            issues = []
        if dates:
            lines.append("")
            lines.append("## Upcoming events (knowledge vault)")
            lines.extend(f"- {d}" for d in dates)
        if issues:
            lines.append("")
            lines.append(f"## Open issues ({len(issues)})")
            lines.extend(f"- {i}" for i in issues)
    if not dates:
        dates = _knowledge_dates(matter / "KNOWLEDGE.md", dates_limit)
        if dates:
            lines.append("")
            lines.append("## Dates and hearings (from KNOWLEDGE.md)")
            lines.extend(dates)

    todo = _list_items(matter / "TODO.md", todo_limit)
    if todo:
        total = _count_items(matter / "TODO.md")
        lines.append("")
        lines.append(f"## Open TODO (top {len(todo)} of {total})")
        lines.extend(t[:160] for t in todo)
    q = _count_items(matter / "QUESTIONS.md")
    if q:
        lines.append(f"- QUESTIONS.md holds {q} open item(s)")

    docket = _git_lines(matter, "log", "-5", "--format=%ad %s", "--date=short",
                        "-E", "--grep", r"^docket")
    if docket:
        lines.append("")
        lines.append("## Recent docket events (git)")
        lines.extend(f"- {d[:140]}" for d in docket)
    last = _git_lines(matter, "log", "-3", "--format=%ad %s", "--date=short")
    if last:
        lines.append("")
        lines.append("## Last commits")
        lines.extend(f"- {d[:140]}" for d in last)

    lines.append("")
    lines.append("## State")
    guard = matter / ".state" / "sync_last_success"
    if guard.is_file():
        lines.append(f"- last successful sync: {_age(guard.stat().st_mtime)}")
    conns = list((cfg.get("connectors") or {}).keys())
    if conns:
        lines.append(f"- connectors: {', '.join(conns)}")
    inbox = matter / "inbox"
    if inbox.is_dir():
        n_inbox = sum(1 for f in inbox.rglob("*") if f.is_file() and not f.name.startswith("."))
        lines.append(f"- inbox/: {n_inbox} untriaged file(s)")
    dirty = _git_lines(matter, "status", "--short")
    if (matter / ".git").exists():
        lines.append(f"- working tree: {len(dirty)} changed path(s)")
    know = matter / "KNOWLEDGE.md"
    if know.is_file():
        n = sum(1 for _ in know.open(errors="replace"))
        lines.append(f"- KNOWLEDGE.md: {n} lines; read the section you need, not the file")
    try:
        tc = _text_coverage()
        lines.append("- " + tc.coverage_line(tc.audit(matter)))
    except Exception as exc:  # the brief must never fail on a coverage error
        lines.append(f"- text coverage: audit failed ({type(exc).__name__})")

    lines.append("")
    lines.append("## Routine commands (deterministic; no deliberation needed)")
    lines.append("`/build <envelope>` `/build-doc <src>` `/open <envelope>` `/clean` "
                 "`/status` `/find <term>` `/commit <type(scope): subject>` --- each runs the CLI and "
                 "reports; a warning that needs a source edit is a separate, visible decision.")
    return "\n".join(lines) + "\n"


