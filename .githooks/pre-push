#!/bin/sh
#
# Two jobs, both cheap, both at the moment they matter most:
#
# 1. Refuse to push machine-specific paths, credential material, or
#    content from the author's prior matter. The suite already
#    enforces all three (tests/test_repo_hygiene.py,
#    tests/test_leak_guard.py); push is the moment a leak stops
#    being local.
#
# 2. Run CI's static gates (ruff check, ruff format --check,
#    mypy tests) so a push cannot land already red. These are the
#    gates 60 consecutive CI runs failed on before September 2026;
#    they take seconds here and a round-trip to notice on GitHub.
#    The pytest gate stays in CI --- too slow for a hook.
#
# Enable once per clone:
#     git config core.hooksPath .githooks
#
# Bypass in an emergency with --no-verify, then fix it immediately:
# the check is cheap, so a bypass almost always means the finding is
# real.

set -e

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

CHECKS="tests/test_repo_hygiene.py tests/test_leak_guard.py"

# uv owns the environment for this repo; fall back to a python that
# already has pytest, for clones driven some other way.
if command -v uv >/dev/null 2>&1; then
  uv run --no-sync ruff check . || exit 1
  uv run --no-sync ruff format --check . || exit 1
  uv run --no-sync mypy tests || exit 1
  exec uv run --no-sync pytest $CHECKS -q --no-header
fi

for py in "${PROSAIC_PYTHON:-}" python3 python; do
  [ -n "$py" ] || continue
  command -v "$py" >/dev/null 2>&1 || continue
  if "$py" -c "import pytest" >/dev/null 2>&1; then
    exec "$py" -m pytest $CHECKS -q --no-header
  fi
done

echo "pre-push: no uv and no python with pytest; hygiene check SKIPPED." >&2
echo "          Install uv, or set PROSAIC_PYTHON." >&2
exit 0
